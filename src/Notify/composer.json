{
    "name": "symfony/ux-notify",
    "type": "symfony-bundle",
    "description": "Native notification integration for Symfony",
    "keywords": [
        "symfony-ux"
    ],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Mathias Arlaud",
            "email": "mathias.arlaud@gmail.com"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Symfony\\UX\\Notify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\UX\\Notify\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/mercure-bundle": "^0.3.4",
        "symfony/mercure-notifier": "^6.4|^7.0|^8.0",
        "symfony/stimulus-bundle": "^2.9.1",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/phpunit-bridge": "^7.2|^8.0",
        "symfony/var-dumper": "^6.4|^7.0|^8.0"
    },
    "conflict": {
        "symfony/config": "<6.4"
    },
    "extra": {
        "thanks": {
            "name": "symfony/ux",
            "url": "https://github.com/symfony/ux"
        }
    },
    "minimum-stability": "dev"
}
