{
    "name": "symfony/ux-router",
    "type": "symfony-bundle",
    "description": "Exposes Symfony Routes directly to JavaScript.",
    "keywords": [
        "symfony-ux"
    ],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Hugo Alliaume",
            "email": "hugo@alliau.me"
        },
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "autoload": {
        "psr-4": {
            "Symfony\\UX\\Router\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\UX\\Router\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "symfony/config": "^7.4|^8.0",
        "symfony/console": "^7.4|^8.0",
        "symfony/dependency-injection": "^7.4|^8.0",
        "symfony/filesystem": "^7.4|^8.0",
        "symfony/http-kernel": "^7.4|^8.0",
        "symfony/routing": "^7.4|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.1|^12.0",
        "symfony/asset-mapper": "^7.4|^8.0",
        "symfony/framework-bundle": "^7.4|^8.0",
        "symfony/var-dumper": "^7.4|^8.0",
        "symfony/yaml": "^7.4|^8.0"
    },
    "extra": {
        "thanks": {
            "name": "symfony/ux",
            "url": "https://github.com/symfony/ux"
        }
    },
    "minimum-stability": "dev"
}
