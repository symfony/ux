{% set reveal_label = this.revealLabel ?? ('Reveal'|trans({}, 'DiscloseBundle')) %}
{% set hide_label = this.hideLabel ?? ('Hide'|trans({}, 'DiscloseBundle')) %}
{% set title = this.title ?? ('Click to disclose. Disclosures are rate limited, use only when necessary.'|trans({}, 'DiscloseBundle')) %}
{% set defaults = {
    'data-controller': 'disclose',
    'data-disclose-url-value': this.url,
    'data-disclose-mask-value': this.mask,
    'data-disclose-render-html-value': this.renderHtml ? 'true' : 'false',
    'data-disclose-reveal-label-value': reveal_label,
    'data-disclose-hide-label-value': hide_label,
    'data-disclose-loading-label-value': this.loadingLabel ?? ('Loading'|trans({}, 'DiscloseBundle')),
    'data-disclose-error-label-value': this.errorLabel ?? ('Unable to disclose.'|trans({}, 'DiscloseBundle')),
    'data-disclose-rate-limited-label-value': this.rateLimitedLabel ?? ('Rate limit exceeded. Try again later.'|trans({}, 'DiscloseBundle')),
} %}
{% if this.toggle %}
    {% set defaults = defaults|merge({'data-disclose-toggle-value': 'true'}) %}
{% endif %}
<div {{ attributes.defaults(defaults) }}>
    {# View 1: the masked trigger #}
    {% block button %}
        <button
            type="button"
            class="disclose-trigger"
            data-disclose-target="button"
            data-action="{{ this.toggle ? 'disclose#toggle:stop' : 'disclose#reveal:stop' }}"
            aria-label="{{ reveal_label }}"
            title="{{ title }}"
        >
            <span class="disclose-mask" aria-hidden="true">{{ this.mask }}</span>
            {% if this.toggle %}
                <span class="disclose-spinner" aria-hidden="true"></span>
                <svg class="disclose-icon disclose-icon--eye-slash" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                <svg class="disclose-icon disclose-icon--eye" viewBox="0 0 24 24" width="1em" height="1em" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            {% endif %}
        </button>
    {% endblock %}

    {# View 2: the data display, hidden until revealed. The Stimulus controller
       injects the revealed markup into the "value" target on click.

       Callers may author an optional {% block reveal %} inside the component
       tag: it is rendered by the disclosure endpoint with the resolved
       "subject" (never on the initial mount), so the secret stays out of the
       page HTML. When no "reveal" block is provided, the scalar value returned
       by the endpoint is inserted as plain text instead. #}
    {% block content %}
        <div class="disclose-content" data-disclose-target="content" hidden>
            {% block value %}
                <div class="disclose-value" data-disclose-target="value"></div>
            {% endblock %}
            {% if not this.toggle %}
                <button
                    type="button"
                    class="disclose-hide"
                    data-disclose-target="hideButton"
                    data-action="disclose#hide:stop"
                    hidden
                >{{ hide_label }}</button>
            {% endif %}
        </div>
    {% endblock %}

    {% block error %}
        <div class="disclose-error" data-disclose-target="error" role="alert" hidden></div>
    {% endblock %}
</div>
