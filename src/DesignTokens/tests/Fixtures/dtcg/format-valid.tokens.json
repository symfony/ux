{
    "$description": "Minimal DTCG 2025.10 format fixture",
    "brand": {
        "$type": "color",
        "primary": {
            "$value": {
                "colorSpace": "srgb",
                "components": [0.2, 0.4, 0.8],
                "alpha": 1
            }
        }
    },
    "space": {
        "$type": "dimension",
        "$root": {
            "$value": {
                "value": 16,
                "unit": "px"
            }
        },
        "large": {
            "$value": {
                "value": 2,
                "unit": "rem"
            }
        }
    },
    "motion": {
        "duration": {
            "$type": "duration",
            "$value": {
                "value": 250,
                "unit": "ms"
            }
        }
    }
}
