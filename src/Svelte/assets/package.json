{
    "name": "@symfony/ux-svelte",
    "description": "Integration of Svelte in Symfony",
    "license": "MIT",
    "version": "2.27.0",
    "keywords": [
        "symfony-ux"
    ],
    "homepage": "https://ux.symfony.com/svelte",
    "repository": "https://github.com/symfony/ux-svelte",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/register_controller.js",
    "scripts": {
        "build": "tsx ../../../bin/build_package.ts .",
        "watch": "tsx ../../../bin/build_package.ts . --watch",
        "test": "../../../bin/test_package.sh .",
        "check": "biome check",
        "ci": "biome ci"
    },
    "symfony": {
        "controllers": {
            "svelte": {
                "main": "dist/render_controller.js",
                "fetch": "eager",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0",
            "svelte/internal": "^3.0",
            "@symfony/ux-svelte": "path:%PACKAGE%/dist/loader.js"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "svelte": "^3.0 || ^4.0"
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@sveltejs/vite-plugin-svelte": "^2.4.6",
        "@testing-library/dom": "catalog:",
        "@testing-library/jest-dom": "catalog:",
        "@testing-library/user-event": "catalog:",
        "@types/webpack-env": "^1.16",
        "jsdom": "catalog:",
        "svelte": "^3.0 || ^4.0",
        "tslib": "catalog:",
        "tsx": "catalog:",
        "typescript": "catalog:",
        "vitest": "catalog:"
    }
}
