{% if previewUrl %}
    <div class="toolkit-code-preview" style="height: {{ height }};">
        <iframe class="toolkit-code-preview__frame" src="{{ previewUrl }}" loading="lazy" style="height: {{ height }};"></iframe>
    </div>
{% else %}
    <div class="toolkit-code-preview toolkit-code-preview--static" data-controller="toolkit-clipboard">
        <button type="button" class="toolkit-code-preview__copy" data-toolkit-clipboard-target="button" data-action="toolkit-clipboard#copy">Copy</button>
        <pre><code data-toolkit-clipboard-target="source">{{ code }}</code></pre>
    </div>
{% endif %}
