{%- props
    ## string Unique identifier used to generate internal Modal IDs.
    id,
    ## boolean Whether the modal is open on initial render.
    open = false
-%}
{%- set _modal_id = 'modal-' ~ id -%}
{%- do provide('modal.id', _modal_id) -%}
{%- do provide('modal.titleId', _modal_id ~ '-title') -%}
{%- do provide('modal.open', open) -%}
<div
    data-modal-open-value="{{ open ? 'true' : 'false' }}"
    {{ attributes.defaults({
        'data-controller': 'modal',
    }) }}
>
    {##- The modal structure, typically includes `Modal:Trigger` and `Modal:Content`. -#}
    {%- block content %}{% endblock -%}
</div>
