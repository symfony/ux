{%- set _dropdownMenu_open = inject('dropdownMenu.open', false) -%}
{%- set _dropdownMenu_side = inject('dropdownMenu.side', 'bottom') -%}
{%- set _dropdownMenu_align = inject('dropdownMenu.align', 'start') -%}
{%- set _dropdownMenu_contentId = inject('dropdownMenu.contentId', null) -%}
{%- set _dropdownMenu_triggerId = inject('dropdownMenu.triggerId', null) -%}
{#- `anchor()` insets rather than `position-area`, which Firefox misplaces in right-to-left: https://bugzil.la/2019601 -#}
{%- set style = html_cva(
    base: 'invisible scale-95 opacity-0 transition-[opacity,scale,visibility] duration-100 ease-out group-data-[state=open]/dropdown-menu:transition-[opacity,scale] group-data-[state=open]/dropdown-menu:visible group-data-[state=open]/dropdown-menu:scale-100 group-data-[state=open]/dropdown-menu:opacity-100 absolute z-50 min-w-32 rounded-lg bg-popover p-1 text-popover-foreground shadow-md ring-1 ring-foreground/10 outline-hidden overflow-visible [--dropdown-menu-trigger-width:100%] [&[popover]]:[--dropdown-menu-trigger-width:anchor-size(width)] [&[popover]:not(:popover-open)]:hidden [&[popover]]:inset-auto [&[popover]]:transition-[opacity,scale,visibility,display,overlay] [&[popover]:popover-open]:visible [&[popover]:popover-open]:transition-[opacity,scale,display,overlay] [&[popover]]:transition-discrete starting:open:scale-95 starting:open:opacity-0',
    variants: {
        side: {
            top: 'bottom-full mb-2',
            bottom: 'top-full mt-2',
            left: 'right-full mr-2',
            right: 'left-full ml-2',
        },
    },
    compound_variants: [
        {side: ['top'], align: ['start'], class: '[&[popover]]:bottom-[anchor(top)] [&[popover]]:start-[anchor(inside)] start-0 ltr:origin-bottom-left rtl:origin-bottom-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['top'], align: ['center'], class: '[&[popover]]:bottom-[anchor(top)] [&[popover]]:left-[anchor(center)] [&[popover]]:-translate-x-1/2 [&[popover]]:[position-try-fallbacks:flip-block] start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-bottom'},
        {side: ['top'], align: ['end'], class: '[&[popover]]:bottom-[anchor(top)] [&[popover]]:end-[anchor(inside)] end-0 ltr:origin-bottom-right rtl:origin-bottom-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['bottom'], align: ['start'], class: '[&[popover]]:top-[anchor(bottom)] [&[popover]]:start-[anchor(inside)] start-0 ltr:origin-top-left rtl:origin-top-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['bottom'], align: ['center'], class: '[&[popover]]:top-[anchor(bottom)] [&[popover]]:left-[anchor(center)] [&[popover]]:-translate-x-1/2 [&[popover]]:[position-try-fallbacks:flip-block] start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-top'},
        {side: ['bottom'], align: ['end'], class: '[&[popover]]:top-[anchor(bottom)] [&[popover]]:end-[anchor(inside)] end-0 ltr:origin-top-right rtl:origin-top-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['left'], align: ['start'], class: '[&[popover]]:right-[anchor(left)] [&[popover]]:top-[anchor(top)] top-0 origin-top-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] [&[popover]]:translate-none'},
        {side: ['left'], align: ['center'], class: '[&[popover]]:right-[anchor(left)] [&[popover]]:[align-self:anchor-center] top-1/2 -translate-y-1/2 origin-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] [&[popover]]:translate-none'},
        {side: ['left'], align: ['end'], class: '[&[popover]]:right-[anchor(left)] [&[popover]]:bottom-[anchor(bottom)] bottom-0 origin-bottom-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] [&[popover]]:translate-none'},
        {side: ['right'], align: ['start'], class: '[&[popover]]:left-[anchor(right)] [&[popover]]:top-[anchor(top)] top-0 origin-top-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] [&[popover]]:translate-none'},
        {side: ['right'], align: ['center'], class: '[&[popover]]:left-[anchor(right)] [&[popover]]:[align-self:anchor-center] top-1/2 -translate-y-1/2 origin-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] [&[popover]]:translate-none'},
        {side: ['right'], align: ['end'], class: '[&[popover]]:left-[anchor(right)] [&[popover]]:bottom-[anchor(bottom)] bottom-0 origin-bottom-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline] [&[popover]]:translate-none'},
    ],
) -%}
<div
    id="{{ _dropdownMenu_contentId }}"
    role="menu"
    tabindex="-1"
    aria-labelledby="{{ _dropdownMenu_triggerId }}"
    data-slot="dropdown-menu-content"
    data-dropdown-menu-target="content"
    data-state="{{ _dropdownMenu_open ? 'open' : 'closed' }}"
    data-side="{{ _dropdownMenu_side }}"
    data-align="{{ _dropdownMenu_align }}"
    data-action="keydown->dropdown-menu#onContentKeydown"
    {{ attributes.defaults({
        class: style.apply({side: _dropdownMenu_side, align: _dropdownMenu_align})|tailwind_classes,
    }) }}
>
    {##- The menu items, e.g. `DropdownMenu:Item`, `DropdownMenu:Separator`. -#}
    {%- block content %}{% endblock -%}
</div>
