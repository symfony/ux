{# @block content The empty state content, typically includes `Empty:Media`, `Empty:Header`, and/or `Empty:Content` #}
<div
    class="{{ ('flex w-full min-w-0 flex-1 flex-col items-center justify-center gap-4 rounded-xl border-dashed p-6 text-center text-balance ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({'data-slot': 'empty'}) }}
>
    {%- block content %}{% endblock -%}
</div>
