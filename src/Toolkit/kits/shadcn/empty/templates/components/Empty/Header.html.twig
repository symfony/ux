    class="{{ ('flex max-w-sm flex-col items-center gap-2 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({'data-slot': 'empty-header'}) }}
>
    {%- block content %}{% endblock -%}
</div>
