<form {{ attributes }}>
    <twig:Sidebar:Group class="py-0">
        <twig:Sidebar:GroupContent class="relative">
            <twig:Label for="search" class="sr-only">
                Search
            </twig:Label>
            <twig:Sidebar:Input
                id="search"
                placeholder="Search the docs..."
                class="ps-8"
            />
            <twig:ux:icon name="lucide:search" class="pointer-events-none absolute start-2 top-1/2 size-4 -translate-y-1/2 opacity-50 select-none" />
        </twig:Sidebar:GroupContent>
    </twig:Sidebar:Group>
</form>
