{%- props
    ## string Id of the `Sidebar:Provider` to control. Defaults to the id of the surrounding provider.
    for = null,
    ## string Accessible label announced for the trigger.
    label = 'Toggle Sidebar'
-%}
{%- set _sidebar_for = for ?? inject('sidebar.id', null) -%}
{%- set _sidebar_initial_open = inject('sidebar.defaultOpen', true) -%}
<button
    data-slot="sidebar-trigger"
    aria-expanded="{{ _sidebar_initial_open ? 'true' : 'false' }}"
    {% if _sidebar_for %}data-sidebar-target="{{ _sidebar_for }}" aria-controls="{{ _sidebar_for }}"{% endif %}
    {{ attributes.defaults({
        type: 'button',
        'aria-label': label,
        class: 'inline-flex size-7 shrink-0 items-center justify-center rounded-[min(var(--radius-md),12px)] border border-transparent bg-clip-padding text-sm font-medium outline-none transition-all hover:bg-muted hover:text-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 dark:hover:bg-muted/50 [&_svg:not([class*=size-])]:size-4 [&_svg]:pointer-events-none [&_svg]:shrink-0'|tailwind_classes,
        'data-action': 'click->sidebar#toggle',
    }) }}
>
    {##- The trigger's icon (typically a `lucide:panel-left`). -#}
    {%- block content %}{% endblock -%}
</button>
