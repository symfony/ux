<twig:Card class="gap-2 py-4 shadow-none">
    <twig:Card:Header class="px-4">
        <twig:Card:Title class="text-sm">Subscribe to our newsletter</twig:Card:Title>
        <twig:Card:Description>
            Opt-in to receive updates and news about the sidebar.
        </twig:Card:Description>
    </twig:Card:Header>
    <twig:Card:Content class="px-4">
        <form>
            <div class="grid gap-2.5">
                <twig:Sidebar:Input type="email" placeholder="Email" />
                <twig:Button type="submit" class="w-full bg-sidebar-primary text-sidebar-primary-foreground shadow-none">
                    Subscribe
                </twig:Button>
            </div>
        </form>
    </twig:Card:Content>
</twig:Card>
