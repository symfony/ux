{# @prop orientation 'horizontal'|'vertical' The separator orientation. #}
{# @prop decorative bool Whether the separator is purely decorative (not semantic). #}
{%- props orientation = 'horizontal', decorative = true -%}
<twig:Separator
    orientation="{{ orientation }}"
    decorative="{{ decorative }}"
    {{ ...attributes.defaults({class: 'my-2'|tailwind_classes}) }}
/>
