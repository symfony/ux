<li
    data-slot="breadcrumb-separator"
    role="presentation"
    aria-hidden="true"
    {{ attributes.defaults({
        class: '[&>svg]:size-3.5'|tailwind_classes,
    }) }}
>
    {##- The separator icon between breadcrumb items, defaults to a chevron. -#}
    {%- block content -%}
        <twig:ux:icon name="lucide:chevron-right" class="rtl:rotate-180" />
    {%- endblock %}
</li>
