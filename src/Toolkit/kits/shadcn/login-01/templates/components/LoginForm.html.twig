<div
    {{ attributes.defaults({
        class: 'flex flex-col gap-6'|tailwind_classes,
    }) }}
>
    {##- Optional content to override the entire form. -#}
    {%- block content -%}
        <twig:Card>
            <twig:Card:Header>
                <twig:Card:Title>Login to your account</twig:Card:Title>
                <twig:Card:Description>
                    Enter your email below to login to your account
                </twig:Card:Description>
            </twig:Card:Header>
            <twig:Card:Content>
                <form>
                    <twig:Field:Group>
                        <twig:Field>
                            <twig:Field:Label for="email">Email</twig:Field:Label>
                            <twig:Input
                                id="email"
                                type="email"
                                placeholder="m@example.com"
                                required
                            />
                        </twig:Field>
                        <twig:Field>
                            <div class="flex items-center">
                                <twig:Field:Label for="password">Password</twig:Field:Label>
                                <a
                                    href="#"
                                    class="ms-auto inline-block text-sm underline-offset-4 hover:underline"
                                >
                                    Forgot your password?
                                </a>
                            </div>
                            <twig:Input id="password" type="password" required />
                        </twig:Field>
                        <twig:Field>
                            <twig:Button type="submit">Login</twig:Button>
                            <twig:Button variant="outline" type="button">
                                Login with Google
                            </twig:Button>
                            <twig:Field:Description class="text-center">
                                Don't have an account? <a href="#">Sign up</a>
                            </twig:Field:Description>
                        </twig:Field>
                    </twig:Field:Group>
                </form>
            </twig:Card:Content>
        </twig:Card>
    {%- endblock -%}
</div>
