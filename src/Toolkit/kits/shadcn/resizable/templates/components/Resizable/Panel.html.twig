{%- props
    ## int|null Initial size as a flex-grow value (proportional). If omitted, panels share space equally.
    size = null
-%}
<div
    style="flex: {{ size ?? 1 }} 1 0%;"
    data-slot="resizable-panel"
    data-resizable-target="panel"
    {{ attributes.defaults({
        class: 'overflow-auto'|tailwind_classes,
    }) }}
>
    {##- The panel content. -#}
    {%- block content %}{% endblock -%}
</div>
