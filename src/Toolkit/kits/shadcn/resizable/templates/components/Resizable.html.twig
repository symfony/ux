{%- props
    ## 'horizontal'|'vertical' Layout direction.
    orientation = 'horizontal'
-%}
<div
    data-slot="resizable-panel-group"
    data-resizable-orientation-value="{{ orientation }}"
    data-orientation="{{ orientation }}"
    aria-orientation="{{ orientation }}"
    {{ attributes.defaults({
        class: 'group/resizable flex h-full w-full aria-[orientation=vertical]:flex-col'|tailwind_classes,
        'data-controller': 'resizable',
    }) }}
>
    {##- One or more `Resizable:Panel` separated by `Resizable:Handle`. -#}
    {%- block content %}{% endblock -%}
</div>
