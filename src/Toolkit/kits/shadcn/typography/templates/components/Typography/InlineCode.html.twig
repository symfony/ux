{# @block content The inline code content #}
<code
    class="{{ ('relative rounded bg-muted px-[0.3rem] py-[0.2rem] font-mono text-sm font-semibold ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'typography-inline-code',
    }) }}
>
    {%- block content %}{% endblock -%}
</code>
