{# @block content The heading content. #}
<h2
    class="{{ ('scroll-m-20 border-b pb-2 text-3xl font-semibold tracking-tight first:mt-0 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'typography-h2',
    }) }}
>
    {%- block content %}{% endblock -%}
</h2>
