{%- props
    ## 'top'|'right'|'bottom'|'left' Which side of the input the content appears on.
    side = 'bottom',
    ## 'start'|'center'|'end' Alignment of the content along the cross axis.
    align = 'start'
-%}
{%- set _combobox_open = inject('combobox.open', false) -%}
{%- set _combobox_contentId = inject('combobox.contentId', null) -%}
{%- set style = html_cva(
    base: 'group/combobox-content invisible absolute z-50 flex max-h-72 w-full min-w-36 scale-95 flex-col overflow-hidden rounded-lg bg-popover text-popover-foreground opacity-0 shadow-md ring-1 ring-foreground/10 transition-[opacity,scale,visibility] duration-150 ease-out group-data-[state=open]/combobox:visible group-data-[state=open]/combobox:scale-100 group-data-[state=open]/combobox:opacity-100 *:data-[slot=input-group]:m-1 *:data-[slot=input-group]:mb-0 *:data-[slot=input-group]:h-8 *:data-[slot=input-group]:border-input/30 *:data-[slot=input-group]:bg-input/30 *:data-[slot=input-group]:shadow-none',
    variants: {
        side: {
            top: 'bottom-full mb-1.5',
            bottom: 'top-full mt-1.5',
            left: 'right-full top-1/2 -translate-y-1/2 mr-1.5 origin-right',
            right: 'left-full top-1/2 -translate-y-1/2 ml-1.5 origin-left',
        },
    },
    compound_variants: [
        {side: ['top'], align: ['start'], class: 'start-0 ltr:origin-bottom-left rtl:origin-bottom-right'},
        {side: ['top'], align: ['center'], class: 'start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-bottom'},
        {side: ['top'], align: ['end'], class: 'end-0 ltr:origin-bottom-right rtl:origin-bottom-left'},
        {side: ['bottom'], align: ['start'], class: 'start-0 ltr:origin-top-left rtl:origin-top-right'},
        {side: ['bottom'], align: ['center'], class: 'start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-top'},
        {side: ['bottom'], align: ['end'], class: 'end-0 ltr:origin-top-right rtl:origin-top-left'},
    ],
) -%}
<div
    id="{{ _combobox_contentId }}"
    data-slot="combobox-content"
    data-combobox-target="content"
    data-side="{{ side }}"
    data-align="{{ align }}"
    data-state="{{ _combobox_open ? 'open' : 'closed' }}"
    aria-hidden="{{ _combobox_open ? 'false' : 'true' }}"
    {{ attributes.defaults({
        class: style.apply({side: side, align: align})|tailwind_classes,
    }) }}
>
    {##- The content body, typically a `Combobox:Empty` and a `Combobox:List`. -#}
    {%- block content %}{% endblock -%}
</div>
