{%- props
    ## string Unique identifier used to generate the internal Combobox IDs.
    id,
    ## string|null If set, renders the hidden inputs carrying the selection on form submission.
    name = null,
    ## string|array<string>|null The initially selected value, or values when `multiple` is enabled.
    value = null,
    ## boolean Whether several values can be selected at once, displayed as chips.
    multiple = false,
    ## boolean Whether the first matching item is highlighted while filtering.
    autoHighlight = false,
    ## boolean Whether the list is open on initial render.
    open = false,
    ## boolean Whether a value must be selected before the form can be submitted.
    required = false
-%}
{%- set _value = null == value ? [] : (value is iterable ? value : [value]) -%}
{%- do provide('combobox.id', id) -%}
{%- do provide('combobox.open', open) -%}
{%- do provide('combobox.multiple', multiple) -%}
{%- do provide('combobox.required', required) -%}
{%- do provide('combobox.value', _value) -%}
{%- do provide('combobox.inputId', 'combobox-' ~ id ~ '-input') -%}
{%- do provide('combobox.listId', 'combobox-' ~ id ~ '-list') -%}
{%- do provide('combobox.contentId', 'combobox-' ~ id ~ '-content') -%}
<div
    data-slot="combobox"
    data-state="{{ open ? 'open' : 'closed' }}"
    data-multiple="{{ multiple ? 'true' : 'false' }}"
    data-combobox-open-value="{{ open ? 'true' : 'false' }}"
    data-combobox-multiple-value="{{ multiple ? 'true' : 'false' }}"
    data-combobox-auto-highlight-value="{{ autoHighlight ? 'true' : 'false' }}"
    data-combobox-required-value="{{ required ? 'true' : 'false' }}"
    data-combobox-name-value="{{ name }}"
    data-combobox-value-value="{{ _value|json_encode }}"
    {{ attributes.defaults({
        class: 'group/combobox relative w-full'|tailwind_classes,
        'data-controller': 'combobox',
        'data-action': [
            'click@window->combobox#handleOutsideClick',
            'keydown.esc@window->combobox#handleEscape',
        ]|join(' ')|html_attr_type('sst'),
    }) }}
>
    {##- A `Combobox:Input` (or a `Combobox:Chips`) and a `Combobox:Content`. -#}
    {%- block content %}{% endblock -%}
    {%- if null != name -%}
        {%- if multiple -%}
            {%- for selected in _value -%}
                <input type="hidden" name="{{ name ~ '[]' }}" value="{{ selected }}" data-combobox-hidden-input>
            {%- endfor -%}
        {%- else -%}
            <input type="hidden" name="{{ name }}" value="{{ _value|first|default('') }}" data-combobox-hidden-input>
        {%- endif -%}
    {%- endif -%}
</div>
