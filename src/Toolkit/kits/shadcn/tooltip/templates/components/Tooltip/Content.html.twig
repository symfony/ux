{%- props
    ## 'top'|'right'|'bottom'|'left' The preferred side to display the tooltip.
    side = 'top',
    ## number The distance in pixels from the trigger.
    sideOffset = 0
-%}
{%- set _tooltip_wrapperId = inject('tooltip.wrapperId') -%}
{%- set _tooltip_contentId = inject('tooltip.contentId') -%}
{%- set _tooltip_arrowId = inject('tooltip.arrowId') -%}
{#- `anchor()` insets rather than `position-area`, which Firefox misplaces in right-to-left: https://bugzil.la/2019601 -#}

<div
    id="{{ _tooltip_wrapperId }}"
    data-slot="tooltip-wrapper"
    data-side="{{ side }}"
    data-side-offset="{{ sideOffset }}"
    data-tooltip-target="wrapper"
    role="presentation"
    popover="manual"
    class="isolate z-50 pointer-events-none open:pointer-events-auto block overflow-visible bg-transparent fixed inset-auto top-0 left-0 will-change-transform [&[data-anchored]]:inset-auto [&[data-anchored]]:w-max [&[data-anchored]]:data-[side=top]:bottom-[anchor(top)] [&[data-anchored]]:data-[side=top]:left-[anchor(center)] [&[data-anchored]]:data-[side=bottom]:top-[anchor(bottom)] [&[data-anchored]]:data-[side=bottom]:left-[anchor(center)] [&[data-anchored]]:data-[side=left]:right-[anchor(left)] [&[data-anchored]]:data-[side=left]:[align-self:anchor-center] [&[data-anchored]]:data-[side=right]:left-[anchor(right)] [&[data-anchored]]:data-[side=right]:[align-self:anchor-center]"
>
    <div
        id="{{ _tooltip_contentId }}"
        role="tooltip"
        data-slot="tooltip-content"
        data-side="{{ side }}"
        data-tooltip-target="content"
        {{ attributes.defaults({
            class: 'z-50 inline-flex w-fit max-w-xs items-center gap-1.5 rounded-md bg-foreground px-3 py-1.5 text-xs text-background data-[side=top]:text-center data-[side=bottom]:text-center data-[side=left]:text-right data-[side=right]:text-left has-data-[slot=kbd]:pe-1.5 **:data-[slot=kbd]:relative **:data-[slot=kbd]:isolate **:data-[slot=kbd]:z-50 **:data-[slot=kbd]:rounded-sm invisible opacity-0 scale-95 transition-all duration-200 open:visible open:opacity-100 open:scale-100'|tailwind_classes,
        }) }}
    >
        {##- The tooltip text or content. -#}
        {%- block content %}{% endblock -%}

        <div
            id="{{ _tooltip_arrowId }}"
            data-side="{{ side }}"
            data-tooltip-target="arrow"
            aria-hidden="true"
            class="bg-foreground fill-foreground z-50 size-2.5 translate-y-[calc(-50%_-_2px)] rotate-45 rounded-[2px] data-[side=bottom]:top-1 data-[side=left]:top-1/2! data-[side=left]:-right-1 data-[side=left]:-translate-y-1/2 data-[side=right]:top-1/2! data-[side=right]:-left-1 data-[side=right]:-translate-y-1/2 data-[side=top]:-bottom-2.5"
            style="position: absolute;"
        ></div>{#- trim: this trailing whitespace text node would otherwise be a phantom flex item spaced by the content's gap-* class -#}
    </div>
</div>
