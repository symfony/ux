{%- props
    ## 'div' The HTML tag to render.
    as = 'div'
-%}
<{{ as }}
    data-slot="button-group-text"
    {{ attributes.defaults({
        class: ('flex items-center gap-2 rounded-lg border bg-muted px-2.5 text-sm font-medium [&_svg]:pointer-events-none [&_svg:not([class*=\'size-\'])]:size-4 ')|tailwind_classes,
    }) }}
>
    {##- The text content displayed in the button group. -#}
    {%- block content %}{% endblock -%}
</{{ as }}>
