{%- props
    ## 'default'|'sm' The trigger size.
    size = 'default'
-%}
{%- set _select_value = inject('select.value', '') -%}
{%- set _select_open = inject('select.open', false) -%}
{%- set _select_disabled = inject('select.disabled', false) -%}
{%- set _select_triggerId = inject('select.triggerId', null) -%}
{%- set _select_contentId = inject('select.contentId', null) -%}
{%- set style = html_cva(
    base: 'flex w-fit items-center justify-between gap-1.5 rounded-lg border border-input bg-transparent py-2 pe-2 ps-2.5 text-sm whitespace-nowrap transition-colors outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 data-[has-value=false]:text-muted-foreground dark:bg-input/30 dark:hover:bg-input/50 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-1.5 *:data-[slot=select-value]:flex [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*=size-])]:size-4',
    variants: {
        size: {
            default: 'h-8',
            sm: 'h-7 rounded-[min(var(--radius-md),10px)]',
        },
    },
) -%}
<button
    type="button"
    role="combobox"
    id="{{ _select_triggerId }}"
    data-slot="select-trigger"
    data-select-target="trigger"
    data-size="{{ size }}"
    data-state="{{ _select_open ? 'open' : 'closed' }}"
    data-has-value="{{ _select_value is empty ? 'false' : 'true' }}"
    aria-haspopup="listbox"
    aria-controls="{{ _select_contentId }}"
    aria-expanded="{{ _select_open ? 'true' : 'false' }}"
    {% if _select_disabled %}disabled{% endif %}
    {{ attributes.defaults({
        class: style.apply({size: size})|tailwind_classes,
        'data-action': 'click->select#toggle keydown->select#onTriggerKeydown',
    }) }}
>
    {##- The trigger content, typically a `Select:Value`. -#}
    {%- block content %}{% endblock -%}
    <twig:ux:icon name="lucide:chevron-down" data-slot="select-trigger-icon" class="pointer-events-none size-4 text-muted-foreground" />
</button>
