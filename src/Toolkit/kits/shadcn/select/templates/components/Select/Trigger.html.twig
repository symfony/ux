{# @prop size 'default'|'sm' The trigger size. #}
{# @block content The trigger element containing a `Select:Value`. #}
{%- props size = 'default' -%}
{%- set _select_id = inject('select.id') -%}
{%- set _select_content_id = inject('select.contentId') -%}
{%- set _select_anchor = inject('select.anchor') -%}
{%- set _select_value = inject('select.value') -%}
{%- set _select_disabled = inject('select.disabled') -%}
{%- set select_trigger_attrs = {
    type: 'button',
    id: _select_id,
    role: 'combobox',
    'aria-controls': _select_content_id,
    'aria-expanded': 'false',
    'aria-haspopup': 'listbox',
    'data-slot': 'select-trigger',
    'data-size': size,
    'data-state': 'closed',
    'data-placeholder': _select_value is empty ? 'true' : 'false',
    'data-select-target': 'trigger',
    'data-action': 'keydown->select#onTriggerKeydown'|html_attr_type('sst'),
    popovertarget: _select_content_id,
    style: 'anchor-name: ' ~ _select_anchor ~ ';',
    disabled: _select_disabled,
    class: 'flex w-fit items-center justify-between gap-1.5 rounded-lg border border-input bg-transparent py-2 pe-2 ps-2.5 text-sm whitespace-nowrap transition-colors outline-none select-none focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-3 aria-invalid:ring-destructive/20 data-[placeholder=true]:text-muted-foreground data-[size=default]:h-8 data-[size=sm]:h-7 data-[size=sm]:rounded-[min(var(--radius-md),10px)] dark:bg-input/30 dark:hover:bg-input/50 dark:aria-invalid:border-destructive/50 dark:aria-invalid:ring-destructive/40 *:data-[slot=select-value]:line-clamp-1 *:data-[slot=select-value]:flex *:data-[slot=select-value]:items-center *:data-[slot=select-value]:gap-1.5 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*=\'size-\'])]:size-4',
} -%}
{%- block content %}{% endblock -%}
