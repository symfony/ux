{%- props
    ## 'item-aligned'|'popper' How the content is placed: over the trigger on the selected item, or anchored to the trigger edge.
    position = 'item-aligned',
    ## 'top'|'bottom' Which side of the trigger the content appears on.
    side = 'bottom',
    ## 'start'|'center'|'end' Alignment of the content along the cross axis.
    align = 'start'
-%}
{%- set _select_open = inject('select.open', false) -%}
{%- set _select_triggerId = inject('select.triggerId', null) -%}
{%- set _select_contentId = inject('select.contentId', null) -%}
{%- set style = html_cva(
    base: 'invisible absolute z-50 min-w-36 scale-95 overflow-hidden rounded-lg bg-popover text-popover-foreground opacity-0 shadow-md ring-1 ring-foreground/10 transition-[opacity,scale,visibility] duration-150 ease-out group-data-[state=open]/select:visible group-data-[state=open]/select:scale-100 group-data-[state=open]/select:opacity-100',
    variants: {
        side: {
            top: 'bottom-full mb-1',
            bottom: 'top-full mt-1',
        },
    },
    compound_variants: [
        {side: ['top'], align: ['start'], class: 'start-0 ltr:origin-bottom-left rtl:origin-bottom-right'},
        {side: ['top'], align: ['center'], class: 'start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-bottom'},
        {side: ['top'], align: ['end'], class: 'end-0 ltr:origin-bottom-right rtl:origin-bottom-left'},
        {side: ['bottom'], align: ['start'], class: 'start-0 ltr:origin-top-left rtl:origin-top-right'},
        {side: ['bottom'], align: ['center'], class: 'start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-top'},
        {side: ['bottom'], align: ['end'], class: 'end-0 ltr:origin-top-right rtl:origin-top-left'},
    ],
) -%}
<div
    id="{{ _select_contentId }}"
    data-slot="select-content"
    data-select-target="content"
    data-position="{{ position }}"
    data-side="{{ side }}"
    data-align="{{ align }}"
    data-state="{{ _select_open ? 'open' : 'closed' }}"
    aria-hidden="{{ _select_open ? 'false' : 'true' }}"
    {{ attributes.defaults({
        class: style.apply({side: side, align: align})|tailwind_classes,
        'data-action': 'keydown->select#onContentKeydown',
    }) }}
>
    <div
        hidden
        aria-hidden="true"
        data-slot="select-scroll-up-button"
        data-select-target="scrollUpButton"
        data-action="click->select#scrollUp"
        class="z-10 flex cursor-default items-center justify-center bg-popover py-1 [&_svg:not([class*=size-])]:size-4"
    >
        <twig:ux:icon name="lucide:chevron-up" class="size-4" />
    </div>
    <div
        role="listbox"
        aria-labelledby="{{ _select_triggerId }}"
        data-slot="select-viewport"
        data-select-target="viewport"
        data-action="scroll->select#onViewportScroll"
        class="max-h-72 scroll-my-1 overflow-x-hidden overflow-y-auto"
    >
        {##- The options, typically `Select:Group`, `Select:Label`, `Select:Item` and `Select:Separator` components. -#}
        {%- block content %}{% endblock -%}
    </div>
    <div
        hidden
        aria-hidden="true"
        data-slot="select-scroll-down-button"
        data-select-target="scrollDownButton"
        data-action="click->select#scrollDown"
        class="z-10 flex cursor-default items-center justify-center bg-popover py-1 [&_svg:not([class*=size-])]:size-4"
    >
        <twig:ux:icon name="lucide:chevron-down" class="size-4" />
    </div>
</div>
