{%- props
    ## 'item-aligned'|'popper' How the content is placed: over the trigger on the selected item, or anchored to the trigger edge.
    position = 'item-aligned',
    ## 'top'|'bottom' Which side of the trigger the content appears on.
    side = 'bottom',
    ## 'start'|'center'|'end' Alignment of the content along the cross axis.
    align = 'start'
-%}
{%- set _select_open = inject('select.open', false) -%}
{%- set _select_triggerId = inject('select.triggerId', null) -%}
{%- set _select_contentId = inject('select.contentId', null) -%}
{#- `anchor()` insets rather than `position-area`, which Firefox misplaces in right-to-left: https://bugzil.la/2019601 -#}
{%- set style = html_cva(
    base: 'invisible absolute [&[popover]]:fixed z-50 w-max min-w-36 scale-95 overflow-hidden rounded-lg bg-popover text-popover-foreground opacity-0 shadow-md ring-1 ring-foreground/10 outline-none [transition:opacity_150ms_ease-out,scale_150ms_ease-out,visibility_0s_linear_150ms] group-data-[state=open]/select:visible group-data-[state=open]/select:[transition-delay:0s] group-data-[state=open]/select:scale-100 group-data-[state=open]/select:opacity-100 [&[popover]:not(:popover-open)]:hidden [&[popover]]:inset-auto [&[popover]]:[transition:opacity_150ms_ease-out,scale_150ms_ease-out,visibility_0s_linear_150ms,display_150ms_allow-discrete,overlay_150ms_allow-discrete] [&[popover]:popover-open]:[transition-delay:0s] starting:open:scale-95 starting:open:opacity-0',
    variants: {
        side: {
            top: 'bottom-full mb-1',
            bottom: 'top-full mt-1',
        },
    },
    compound_variants: [
        {side: ['top'], align: ['start'], class: '[&[popover]]:bottom-[anchor(top)] [&[popover]]:start-[anchor(inside)] start-0 ltr:origin-bottom-left rtl:origin-bottom-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['top'], align: ['center'], class: '[&[popover]]:bottom-[anchor(top)] [&[popover]]:left-[anchor(center)] [&[popover]]:-translate-x-1/2 [&[popover]]:[position-try-fallbacks:flip-block] start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-bottom'},
        {side: ['top'], align: ['end'], class: '[&[popover]]:bottom-[anchor(top)] [&[popover]]:end-[anchor(inside)] end-0 ltr:origin-bottom-right rtl:origin-bottom-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['bottom'], align: ['start'], class: '[&[popover]]:top-[anchor(bottom)] [&[popover]]:start-[anchor(inside)] start-0 ltr:origin-top-left rtl:origin-top-right [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
        {side: ['bottom'], align: ['center'], class: '[&[popover]]:top-[anchor(bottom)] [&[popover]]:left-[anchor(center)] [&[popover]]:-translate-x-1/2 [&[popover]]:[position-try-fallbacks:flip-block] start-1/2 -translate-x-1/2 rtl:translate-x-1/2 origin-top'},
        {side: ['bottom'], align: ['end'], class: '[&[popover]]:top-[anchor(bottom)] [&[popover]]:end-[anchor(inside)] end-0 ltr:origin-top-right rtl:origin-top-left [&[popover]]:[position-try-fallbacks:flip-block,flip-inline,flip-block_flip-inline]'},
    ],
) -%}
<div
    id="{{ _select_contentId }}"
    role="listbox"
    tabindex="-1"
    aria-labelledby="{{ _select_triggerId }}"
    data-slot="select-content"
    data-select-target="content"
    data-position="{{ position }}"
    data-side="{{ side }}"
    data-align="{{ align }}"
    data-state="{{ _select_open ? 'open' : 'closed' }}"
    aria-hidden="{{ _select_open ? 'false' : 'true' }}"
    {{ attributes.defaults({
        class: style.apply({side: side, align: align})|tailwind_classes,
        'data-action': 'keydown->select#onContentKeydown',
    }) }}
>
    <div
        hidden
        aria-hidden="true"
        data-slot="select-scroll-up-button"
        data-select-target="scrollUpButton"
        data-action="click->select#scrollUp"
        class="z-10 flex cursor-default items-center justify-center bg-popover py-1 [&_svg:not([class*=size-])]:size-4"
    >
        <twig:ux:icon name="lucide:chevron-up" class="size-4" />
    </div>
    <div
        data-slot="select-viewport"
        data-select-target="viewport"
        data-action="scroll->select#onViewportScroll"
        class="max-h-72 scroll-my-1 overflow-x-hidden overflow-y-auto"
    >
        {##- The options, typically `Select:Group`, `Select:Label`, `Select:Item` and `Select:Separator` components. -#}
        {%- block content %}{% endblock -%}
    </div>
    <div
        hidden
        aria-hidden="true"
        data-slot="select-scroll-down-button"
        data-select-target="scrollDownButton"
        data-action="click->select#scrollDown"
        class="z-10 flex cursor-default items-center justify-center bg-popover py-1 [&_svg:not([class*=size-])]:size-4"
    >
        <twig:ux:icon name="lucide:chevron-down" class="size-4" />
    </div>
</div>
