{%- props
    ## string Unique identifier used to generate the internal Select IDs.
    id,
    ## string|null Name of the hidden input submitted with the form.
    name = null,
    ## string The value selected on initial render.
    value = '',
    ## boolean Whether the select is disabled.
    disabled = false,
    ## boolean Whether the hidden input is required.
    required = false,
    ## boolean Whether the select is open on initial render.
    open = false
-%}
{%- do provide('select.id', id) -%}
{%- do provide('select.value', value) -%}
{%- do provide('select.open', open) -%}
{%- do provide('select.disabled', disabled) -%}
{%- do provide('select.triggerId', 'select-' ~ id ~ '-trigger') -%}
{%- do provide('select.contentId', 'select-' ~ id ~ '-content') -%}
<div
    data-slot="select"
    data-state="{{ open ? 'open' : 'closed' }}"
    data-disabled="{{ disabled ? 'true' : 'false' }}"
    data-select-open-value="{{ open ? 'true' : 'false' }}"
    data-select-value-value="{{ value }}"
    {{ attributes.defaults({
        class: 'group/select relative inline-block'|tailwind_classes,
        'data-controller': 'select',
    }) }}
>
    {%- if name is not null -%}
        <input type="hidden" name="{{ name }}" value="{{ value }}" data-select-target="hiddenInput"{% if required %} required{% endif %}>
    {%- endif -%}
    {##- A `Select:Trigger` and a `Select:Content`. -#}
    {%- block content %}{% endblock -%}
</div>
