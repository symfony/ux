<div
    data-slot="toast-content"
    {{ attributes.defaults({
        class: 'flex h-full items-center gap-3 overflow-hidden p-4 transition-opacity duration-250 ease-[cubic-bezier(0.22,1,0.36,1)] data-behind:opacity-0 data-expanded:opacity-100'|tailwind_classes,
    }) }}
>
    {##- The toast content, typically a `Toast:Icon`, a `Toast:Title`, a `Toast:Description`, a `Toast:Action` and a `Toast:Close`. -#}
    {%- block content %}{% endblock -%}
</div>
