{%- props
    ## string Unique suffix identifier for generating Tabs internal IDs.
    value
-%}
{%- set _tabs_defaultValue = inject('tabs.defaultValue', '') -%}

{%- set _tab_id = 'tab-' ~ value -%}
{%- set _tab_content_id = _tab_id ~ '-description' -%}
{%- set open = _tabs_defaultValue is same as(value) -%}
<div
    id="{{ _tab_content_id }}"
    data-slot="tabs-content"
    data-tabs-target="tab"
    data-tab-id="{{ value }}"
    role="tabpanel"
    aria-labelledby="{{ _tab_id }}"
    data-active="{{ open ? 'true' : 'false' }}"
    data-state="{{ open ? 'active' : 'inactive' }}"
    {{ attributes.defaults({
        class: 'flex-1 text-sm outline-none data-[state=inactive]:hidden'|tailwind_classes,
    }) }}
>
    {##- The default block. -#}
    {%- block content %}{% endblock -%}
</div>
