{# @block content The clickable trigger (e.g., a `Button`) that opens the drawer #}
{%- set drawer_trigger_attrs = {
    'data-slot': 'drawer-trigger',
    'data-drawer-target': 'trigger',
    'data-action': 'click->drawer#toggle'|html_attr_type('sst'),
    'aria-haspopup': 'dialog',
    'aria-expanded': _drawer_open ? 'true' : 'false',
    'data-state': _drawer_open ? 'open' : 'closed',
} -%}
{%- block content %}{% endblock -%}
