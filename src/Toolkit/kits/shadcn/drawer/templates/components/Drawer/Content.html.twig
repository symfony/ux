{# @block content The drawer content #}
<div
    role="dialog"
    aria-modal="true"
    class="{{ ('fixed inset-x-0 bottom-0 z-50 mt-24 flex max-h-[80vh] flex-col rounded-t-[10px] border bg-background p-4 shadow-lg outline-none ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'drawer-content',
    }) }}
>
    <div aria-hidden="true" class="mx-auto mb-4 h-1.5 w-12 rounded-full bg-muted"></div>
    {%- block content %}{% endblock -%}
</div>