{%- set _alertDialog_titleId = inject('alertDialog.titleId') -%}
<h2
    id="{{ _alertDialog_titleId }}"
    data-slot="alert-dialog-title"
    {{ attributes.without('id').defaults({class: 'cn-font-heading text-base font-medium sm:group-data-[size=default]/alert-dialog-content:group-has-data-[slot=alert-dialog-media]/alert-dialog-content:col-start-2'|tailwind_classes}) }}
>
    {##- The title text of the alert dialog. -#}
    {%- block content %}{% endblock -%}
</h2>
