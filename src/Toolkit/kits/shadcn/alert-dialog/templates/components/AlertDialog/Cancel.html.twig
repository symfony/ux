{%- props
    ## 'default'|'secondary'|'destructive'|'outline'|'ghost'|'link' The button style variant.
    variant = 'outline',
    ## 'default'|'sm'|'lg'|'xs'|'icon' The button size.
    size = 'default'
-%}
{%- set _alertDialog_id = inject('alertDialog.id') -%}
<twig:Button variant="{{ variant }}" size="{{ size }}" data-slot="alert-dialog-cancel" command="close" commandfor="{{ _alertDialog_id }}" data-action="click->alert-dialog#close" {{ ...attributes }}>
    {##- The cancel button label. -#}
    {{- block(outerBlocks.content) -}}
</twig:Button>
