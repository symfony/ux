{%- props
    ## array<array{name:string,emoji:string,pages:array<array{name:string,url:string,emoji:string}>}> The workspaces and their pages.
    workspaces
-%}
<twig:Sidebar:Group>
    <twig:Sidebar:GroupLabel>Workspaces</twig:Sidebar:GroupLabel>
    <twig:Sidebar:GroupContent>
        <twig:Sidebar:Menu>
            {%- for workspace in workspaces %}
                <twig:Sidebar:MenuItem>
                    <twig:Collapsible>
                        <twig:Sidebar:MenuButton as="a" href="#">
                            <span>{{ workspace.emoji }}</span>
                            <span>{{ workspace.name }}</span>
                        </twig:Sidebar:MenuButton>
                        <twig:Collapsible:Trigger>
                            <twig:Sidebar:MenuAction
                                {{ ...collapsible_trigger_attrs }}
                                showOnHover
                                class="start-2 bg-sidebar-accent text-sidebar-accent-foreground data-[state=open]:rotate-90 rtl:rotate-180"
                            >
                                <twig:ux:icon name="lucide:chevron-right" />
                            </twig:Sidebar:MenuAction>
                        </twig:Collapsible:Trigger>
                        <twig:Sidebar:MenuAction showOnHover>
                            <twig:ux:icon name="lucide:plus" />
                        </twig:Sidebar:MenuAction>
                        <twig:Collapsible:Content>
                            <twig:Sidebar:MenuSub>
                                {%- for page in workspace.pages %}
                                    <twig:Sidebar:MenuSubItem>
                                        <twig:Sidebar:MenuSubButton href="#">
                                            <span>{{ page.emoji }}</span>
                                            <span>{{ page.name }}</span>
                                        </twig:Sidebar:MenuSubButton>
                                    </twig:Sidebar:MenuSubItem>
                                {%- endfor %}
                            </twig:Sidebar:MenuSub>
                        </twig:Collapsible:Content>
                    </twig:Collapsible>
                </twig:Sidebar:MenuItem>
            {%- endfor %}
            <twig:Sidebar:MenuItem>
                <twig:Sidebar:MenuButton class="text-sidebar-foreground/70">
                    <twig:ux:icon name="lucide:more-horizontal" />
                    <span>More</span>
                </twig:Sidebar:MenuButton>
            </twig:Sidebar:MenuItem>
        </twig:Sidebar:Menu>
    </twig:Sidebar:GroupContent>
</twig:Sidebar:Group>
