{# @block content The clickable trigger (e.g., a `Button`) that opens the sheet #}
{%- set sheet_trigger_attrs = {
    'data-slot': 'sheet-trigger',
    'data-sheet-target': 'trigger',
    'data-action': 'click->sheet#toggle'|html_attr_type('sst'),
    'aria-haspopup': 'dialog',
    'aria-expanded': _sheet_open ? 'true' : 'false',
    'data-state': _sheet_open ? 'open' : 'closed',
} -%}
{%- block content %}{% endblock -%}
