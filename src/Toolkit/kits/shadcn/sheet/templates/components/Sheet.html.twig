{# @prop side 'left'|'right'|'top'|'bottom' Which edge the sheet slides from. Defaults to `right` #}
{# @prop open boolean Whether the sheet is open on initial render. Defaults to `false` #}
{# @block content A `Sheet:Trigger` and a `Sheet:Content` #}
{%- props side = 'right', open = false -%}
{%- set _sheet_side = side -%}
{%- set _sheet_open = open -%}
<div
    class="{{ ('group/sheet ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'sheet',
        'data-side': side,
        'data-controller': 'sheet',
        'data-sheet-open-value': open ? 'true' : 'false',
        'data-action': [
            'click@window->sheet#handleOutsideClick',
            'keydown.esc@window->sheet#handleEscape',
        ]|join(' ')|html_attr_type('sst'),
        'data-state': open ? 'open' : 'closed',
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
