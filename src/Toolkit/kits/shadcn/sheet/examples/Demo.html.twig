<twig:Sheet side="left">
    <twig:Sheet:Trigger class="h-9 rounded-md border border-input bg-background px-4 shadow-xs hover:bg-accent">
        Open left sheet
    </twig:Sheet:Trigger>
    <twig:Sheet:Content>
        <twig:Sheet:Header>
            <twig:Sheet:Title>Edit profile</twig:Sheet:Title>
            <twig:Sheet:Description>Make changes to your profile. Click save when you're done.</twig:Sheet:Description>
        </twig:Sheet:Header>
        <div class="grid gap-4 py-4">
            <div class="grid grid-cols-4 items-center gap-4">
                <twig:Label for="sheet-name" class="text-right">Name</twig:Label>
                <twig:Input id="sheet-name" value="shadcn" class="col-span-3" />
            </div>
            <div class="grid grid-cols-4 items-center gap-4">
                <twig:Label for="sheet-username" class="text-right">Username</twig:Label>
                <twig:Input id="sheet-username" value="@shadcn" class="col-span-3" />
            </div>
        </div>
        <div class="mt-auto flex justify-end">
            <twig:Button type="submit">Save changes</twig:Button>
        </div>
    </twig:Sheet:Content>
</twig:Sheet>