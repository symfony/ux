                        </twig:Button>
                    </div>
                </twig:Collapsible:Content>
            </twig:Collapsible>

            {# Root files #}
            <twig:Button variant="ghost" class="w-full justify-start gap-1.5 h-7 px-2 text-sm">
                <twig:ux:icon name="lucide:file" class="size-3.5 text-muted-foreground" />
