{# @prop side 'top'|'bottom' The side of the bubble the reactions are anchored to. #}
{# @prop align 'start'|'end' The inline alignment of the reactions. #}
{# @block content The reactions, typically emoji or small action buttons. #}
{%- props side = 'bottom', align = 'end' -%}
{%- set style = html_cva(
    base: 'absolute z-10 flex w-fit shrink-0 items-center justify-center gap-1 rounded-full bg-muted px-1.5 py-0.5 text-sm ring-3 ring-card has-[button]:p-0',
    variants: {
        side: {
            top: 'top-0 -translate-y-3/4',
            bottom: 'bottom-0 translate-y-3/4',
        },
        align: {
            start: 'start-3',
            end: 'end-3',
        },
    },
) -%}
<div
    data-slot="bubble-reactions"
    data-side="{{ side }}"
    data-align="{{ align }}"
    {{ attributes.defaults({
        class: style.apply({side: side, align: align})|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
