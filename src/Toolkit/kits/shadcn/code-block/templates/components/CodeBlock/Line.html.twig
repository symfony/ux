{%- props
    ## 'default'|'added'|'removed'|'highlighted' The state of the line.
    variant = 'default'
-%}
{%- set style = html_cva(
    base: "relative -mx-3 block min-h-lh px-3 group-data-[size=sm]/code-block:-mx-2.5 group-data-[size=sm]/code-block:px-2.5 before:min-w-6 before:text-end before:text-muted-foreground after:absolute after:start-1 after:top-0 after:text-muted-foreground after:select-none in-data-numbered:col-span-2 in-data-numbered:grid in-data-numbered:grid-cols-subgrid in-data-numbered:gap-x-3 in-data-numbered:[counter-increment:line] in-data-numbered:before:content-[counter(line)] in-data-numbered:before:select-none in-data-numbered:supports-[content:counter(line)_/_'']:before:content-[counter(line)_/_'']",
    variants: {
        variant: {
            default: '',
            highlighted: 'bg-muted',
            added: "bg-muted after:content-['+']",
            removed: "bg-destructive/10 after:text-destructive after:content-['−']",
        },
    },
) -%}
<span
    data-slot="code-block-line"
    data-variant="{{ variant }}"
    {{ attributes.defaults({
        class: style.apply({variant: variant})|tailwind_classes,
    }) }}
><span data-slot="code-block-line-content" class="min-w-0">
    {%- set _content -%}
        {##- The line content: text or highlighted tokens. An empty line holds a newline, so a copied selection keeps blank lines. -#}
        {{- block('content') -}}
    {%- endset -%}
    {{- _content ?: '\n' -}}
</span></span>
