<twig:RadioGroup>
    <div class="flex items-center gap-3">
        <twig:RadioGroup:Item id="plan-free" name="plan" value="free" checked />
        <twig:Label for="plan-free">Free</twig:Label>
    </div>
    <div class="flex items-center gap-3">
        <twig:RadioGroup:Item id="plan-pro" name="plan" value="pro" />
        <twig:Label for="plan-pro">Pro</twig:Label>
    </div>
</twig:RadioGroup>