{# @block content The radio items, typically multiple `RadioGroup:Item` components with `Label`. #}
<div
    role="radiogroup"
    class="{{ ('grid w-full gap-2 ' ~ attributes.render('class'))|tailwind_merge }}"
    {{ attributes.defaults({
        'data-slot': 'radio-group',
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
