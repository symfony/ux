{# @prop variant 'legend'|'label' The text size variant. #}
{# @block content The legend text for a fieldset. #}
{%- props variant = 'legend' -%}
<legend
    data-slot="field-legend"
    data-variant="{{ variant }}"
    {{ attributes.defaults({
        class: 'mb-1.5 font-medium data-[variant=label]:text-sm data-[variant=legend]:text-base'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</legend>
