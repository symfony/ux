    data-slot="field-group"
    {{ attributes.defaults({
        class: 'group/field-group @container/field-group flex w-full flex-col gap-5 data-[slot=checkbox-group]:gap-3 *:data-[slot=field-group]:gap-4'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
