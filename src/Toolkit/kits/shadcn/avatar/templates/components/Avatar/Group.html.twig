{# @block content The grouped avatars, typically multiple `Avatar` components. #}
<div
    data-slot="avatar-group"
    {{ attributes.defaults({
        class: '*:data-[slot=avatar]:ring-background group/avatar-group flex -space-x-2 *:data-[slot=avatar]:ring-2'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
