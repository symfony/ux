{# @block content The fallback content displayed when no image is available, typically initials. #}
<span
    data-slot="avatar-fallback"
    {{ attributes.defaults({
        class: 'bg-muted text-muted-foreground rounded-full flex size-full items-center justify-center text-sm group-data-[size=sm]/avatar:text-xs'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</span>
