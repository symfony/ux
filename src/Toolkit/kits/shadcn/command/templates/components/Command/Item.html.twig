{%- props
    ## 'div'|'a' The HTML tag to render; use `a` when the item is a link.
    as = 'div',
    ## boolean Whether the item is disabled.
    disabled = false
-%}
<{{ as }}
    role="option"
    {% if as == 'a' %}tabindex="-1"{% endif %}
    data-slot="command-item"
    data-command-target="item"
    data-selected="false"
    data-disabled="{{ disabled ? 'true' : 'false' }}"
    aria-selected="false"
    aria-disabled="{{ disabled ? 'true' : 'false' }}"
    {{ attributes.defaults({
        class: "group/command-item relative flex cursor-default items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-hidden select-none in-data-[slot=dialog-content]:rounded-lg! data-[disabled=true]:pointer-events-none data-[disabled=true]:opacity-50 data-[selected=true]:bg-muted data-[selected=true]:text-foreground data-[selected=true]:*:[svg]:text-foreground [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4"|tailwind_classes,
        'data-action': 'pointermove->command#highlight'|html_attr_type('sst'),
    }) }}
>
    {##- The item content, typically an icon, a label and an optional `Command:Shortcut`. -#}
    {%- block content %}{% endblock -%}
    <twig:ux:icon name="lucide:check" class="ms-auto opacity-0 group-has-data-[slot=command-shortcut]/command-item:hidden group-data-[checked=true]/command-item:opacity-100" />
</{{ as }}>
