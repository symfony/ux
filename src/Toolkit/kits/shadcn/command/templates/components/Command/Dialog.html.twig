{%- props
    ## string The title of the dialog, only announced to assistive technologies.
    title = 'Command Palette',
    ## string The description of the dialog, only announced to assistive technologies.
    description = 'Search for a command to run...',
    ## boolean Whether to display the close button in the top-right corner.
    showCloseButton = false
-%}
<twig:Dialog:Content
    :showCloseButton="showCloseButton"
    {{ ...attributes.defaults({class: 'top-1/3 translate-y-0 overflow-hidden rounded-xl! p-0'|tailwind_classes}) }}
>
    <twig:Dialog:Header class="sr-only">
        <twig:Dialog:Title>{{ title }}</twig:Dialog:Title>
        <twig:Dialog:Description>{{ description }}</twig:Dialog:Description>
    </twig:Dialog:Header>
    {##- The dialog content, typically a `Command`. -#}
    {{- block(outerBlocks.content) -}}
</twig:Dialog:Content>
