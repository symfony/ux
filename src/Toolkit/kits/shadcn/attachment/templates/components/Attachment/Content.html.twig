    data-slot="attachment-content"
    {{ attributes.defaults({
        class: 'max-w-full min-w-0 flex-1 leading-tight group-data-[orientation=vertical]/attachment:px-1'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</div>
