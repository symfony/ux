{# @prop as 'button'|'a' The HTML tag to render; use `a` when the trigger is a link. #}
{# @block content The optional trigger label, usually left empty as the trigger covers the whole attachment. #}
{%- props as = 'button' -%}
<{{ as }}
    data-slot="attachment-trigger"
    {{ attributes.defaults({
        class: 'absolute inset-0 z-10 outline-none'|tailwind_classes,
        type: as == 'button' ? 'button' : false,
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
