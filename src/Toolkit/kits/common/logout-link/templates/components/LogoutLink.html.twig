{% props
    ## string|null The firewall name to log out from; when null, the current firewall is used.
    firewall = null
%}

<twig:PostLink {{ ...attributes.defaults({
    href: logout_path(firewall),
    csrfTokenId: 'logout',
}) }}>
    {## The link label. -#}
    {{ block(outerBlocks.content)|default('Logout') }}
</twig:PostLink>
