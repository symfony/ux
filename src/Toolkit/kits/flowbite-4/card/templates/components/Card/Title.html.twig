{# @prop as string The HTML tag used to render the title. #}
{# @block content The title text of the card. #}
{%- props as = 'span' -%}
<{{ as }}
    {{ attributes.defaults({
        class: 'text-2xl font-semibold tracking-tight text-heading leading-8'|tailwind_classes,
    }) }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
