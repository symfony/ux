<div class="grid w-full max-w-xl items-start gap-4">
    <twig:Alert>
        <twig:ux:icon name="flowbite:info-circle-outline" aria-hidden="true" />
        <twig:Alert:Title>Ensure that these requirements are met:</twig:Alert:Title>
        <twig:Alert:Description>
            <ul class="my-2 list-disc list-outside space-y-1 ps-2.5">
                <li>At least 10 characters (and up to 100 characters)</li>
                <li>At least one lowercase character</li>
                <li>Inclusion of at least one special character, e.g., ! @ # ?</li>
            </ul>
        </twig:Alert:Description>
        <twig:Alert:Action>
            <a href="#">See recomandation here</a>
        </twig:Alert:Action>
    </twig:Alert>
</div>
