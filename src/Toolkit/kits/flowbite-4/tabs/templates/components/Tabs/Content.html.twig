{%- props
    ## string Unique suffix identifier for generating Tabs internal IDs.
    value
-%}

{%- set _tab_id = 'tab-' ~ value -%}
{%- set _tab_content_id = _tab_id ~ '-description' -%}
{%- set open = defaultValue is same as(value) -%}
<div
    id="{{ _tab_content_id }}"
    data-tabs-target="tab"
    data-tab-id="{{ value }}"
    role="tabpanel"
    aria-labelledby="{{ _tab_id }}"
    data-state="{{ open ? 'active' : 'inactive' }}"
    {{ attributes.defaults({
        class: 'data-[state=inactive]:hidden'|tailwind_classes,
    }) }}
>
    {##- The default block. -#}
    {%- block content %}{% endblock -%}
</div>
