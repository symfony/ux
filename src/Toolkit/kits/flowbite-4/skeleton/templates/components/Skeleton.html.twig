{%- props
    ## 'rounded'|'pill' The badge shape.
    shape = 'pill'
-%}
{%- set style = html_cva(
    base: 'animate-pulse bg-neutral-quaternary',
    variants: {
        shape: {
            rounded: 'rounded-base',
            pill: 'rounded-full',
        },
    },
) -%}
<div
    {{ attributes.defaults({
        class: style.apply({shape: shape})|tailwind_classes,
    }) }}
>
    {##- The content rendered inside the skeleton placeholder. -#}
    {%- block content %}{% endblock -%}
</div>
