{%- props
    ## string The CSS selector of the navigation element controlled by Scrollspy.
    target,
    ## string The height of the scrollable region.
    height = '200px',
    ## boolean Whether link activation scrolls smoothly to its target section.
    smoothScroll = false,
    ## string|null The optional Intersection Observer root margin.
    rootMargin = null,
    ## string|null The optional comma-separated Intersection Observer thresholds.
    threshold = null
-%}
{%- set default_attrs = {
    class: 'position-relative overflow-auto',
    style: 'height: ' ~ height ~ ';',
    tabindex: '0',
    'data-bs-spy': 'scroll',
    'data-bs-target': target,
} -%}
{%- if smoothScroll -%}
    {%- set default_attrs = default_attrs|merge({'data-bs-smooth-scroll': 'true'}) -%}
{%- endif -%}
{%- if rootMargin is not null -%}
    {%- set default_attrs = default_attrs|merge({'data-bs-root-margin': rootMargin}) -%}
{%- endif -%}
{%- if threshold is not null -%}
    {%- set default_attrs = default_attrs|merge({'data-bs-threshold': threshold}) -%}
{%- endif -%}
<div {{ attributes.defaults(default_attrs) }}>
    {##- The sections observed by Scrollspy. -#}
    {%- block content %}{% endblock -%}
</div>
