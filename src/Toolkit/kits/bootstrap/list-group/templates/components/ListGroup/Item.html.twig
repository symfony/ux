{# @prop variant 'default'|'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'light'|'dark' The contextual color variant. Defaults to `default` #}
{# @prop active bool Whether the item is active. Defaults to `false` #}
{# @prop disabled bool Whether the item is disabled. Defaults to `false` #}
{# @prop action bool Whether the item is interactive (hover/active states). Defaults to `false` #}
{# @prop as 'li' The HTML tag to render. Use `a` or `button` for action items. Defaults to `li` #}
{# @block content The item content #}
{%- props variant = 'default', active = false, disabled = false, action = false, as = 'li' -%}
{%- set style = html_cva(
    base: 'list-group-item',
    variants: {
        variant: {
            default: '',
            primary: 'list-group-item-primary',
            secondary: 'list-group-item-secondary',
            success: 'list-group-item-success',
            danger: 'list-group-item-danger',
            warning: 'list-group-item-warning',
            info: 'list-group-item-info',
            light: 'list-group-item-light',
            dark: 'list-group-item-dark',
        },
        active: {
            true: 'active',
        },
        disabled: {
            true: 'disabled',
        },
        action: {
            true: 'list-group-item-action',
        },
    },
) -%}
<{{ as }}
    class="{{ style.apply({variant, active, disabled, action}, attributes.render('class')) }}"
    {{ active ? 'aria-current="true"' }}
    {{ disabled and as != 'button' ? 'aria-disabled="true"' }}
    {{ disabled and as == 'button' ? 'disabled' }}
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
