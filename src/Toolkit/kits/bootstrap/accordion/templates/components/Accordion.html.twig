{%- props
    ## string The unique identifier used to coordinate the accordion items.
    id,
    ## boolean Whether to remove outer borders and rounded corners.
    flush = false,
    ## boolean Whether multiple accordion items may remain open.
    alwaysOpen = false
-%}
{%- do provide('accordion.id', id) -%}
{%- do provide('accordion.alwaysOpen', alwaysOpen) -%}
<div {{ attributes.defaults({
    id: id,
    class: html_classes({
        accordion: true,
        'accordion-flush': flush,
    }),
}) }}>
    {##- The accordion items, typically `Accordion:Item` components. -#}
    {%- block content %}{% endblock -%}
</div>
