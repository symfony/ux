{%- props
    ## 'span'|'a'|'div'|'p'|'h1'|'h2'|'h3'|'h4'|'h5'|'h6' The HTML element used for the animation wrapper.
    tag = 'div',
    ## 'glow'|'wave' The Bootstrap placeholder animation.
    animation = 'glow'
-%}

{%- set final_tag = tag in ['span', 'a', 'div', 'p', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'div' -%}
{%- set classes = html_classes({
    ('placeholder-' ~ animation): true,
}) -%}

<{{ final_tag }} {{ attributes.defaults({class: classes, 'aria-hidden': 'true'}) }}>
    {##- The placeholders animated by this wrapper. -#}
    {%- block content -%}{%- endblock -%}
</{{ final_tag }}>
