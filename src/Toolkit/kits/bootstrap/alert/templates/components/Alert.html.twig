{%- props
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'light'|'dark' The Bootstrap contextual color.
    color = 'primary',
    ## boolean Whether to render a dismiss button and dismissal transition classes.
    dismissible = false,
    ## string|null The optional alert heading.
    heading = null,
    ## string The fallback message when no content block is provided.
    content = ''
-%}

{%- set classes = html_classes({
    alert: true,
    ('alert-' ~ color): true,
    'alert-dismissible': dismissible,
    fade: dismissible,
    show: dismissible,
}) -%}

<div {{ attributes.defaults({class: classes, role: 'alert'}) }}>
    {##- The alert heading, rendered before the main content. -#}
    {%- block heading -%}
        {%- if heading is not null and heading is not empty -%}
            <h4 class="alert-heading">{{ heading }}</h4>
        {%- endif -%}
    {%- endblock -%}

    {##- The alert message and optional additional content. -#}
    {%- block content -%}
        {{- content -}}
    {%- endblock -%}

    {%- if dismissible -%}
        {##- The dismiss control rendered when the alert is dismissible. -#}
        {%- block close -%}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        {%- endblock -%}
    {%- endif -%}
</div>
