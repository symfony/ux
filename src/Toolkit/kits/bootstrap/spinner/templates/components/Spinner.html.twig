{%- props
    ## 'border'|'grow' The spinner animation style.
    type = 'border',
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'light'|'dark'|null The Bootstrap contextual text color.
    color = null,
    ## boolean Whether to use Bootstrap's compact spinner size.
    small = false,
    ## string|null The ARIA role used for an announced loading status.
    role = 'status',
    ## string The visually hidden loading message.
    label = 'Loading...',
    ## boolean Whether to hide the spinner from assistive technologies.
    decorative = false
-%}

{%- set spinner_type = type == 'grow' ? 'grow' : 'border' -%}
{%- set spinner_classes = html_classes({
    ('spinner-' ~ spinner_type): true,
    ('spinner-' ~ spinner_type ~ '-sm'): small,
    ('text-' ~ color): color in ['primary', 'secondary', 'success', 'danger', 'warning', 'info', 'light', 'dark'],
}) -%}
{%- set default_attrs = {class: spinner_classes} -%}
{%- if decorative -%}
    {%- set default_attrs = default_attrs|merge({'aria-hidden': 'true'}) -%}
{%- elseif role not in [null, ''] -%}
    {%- set default_attrs = default_attrs|merge({role: role}) -%}
{%- endif -%}

<div {{ attributes.defaults(default_attrs) }}>
    {##- The accessible loading message or custom inner content. -#}
    {%- block content -%}
        {%- if not decorative -%}
            <span class="visually-hidden">{{ label }}</span>
        {%- endif -%}
    {%- endblock -%}
</div>
