{# @prop id string The unique identifier targeted by modal controls. #}
{# @prop size 'sm'|'lg'|'xl'|null The optional maximum width of the modal dialog. #}
{# @prop centered boolean Whether to vertically center the modal dialog. #}
{# @prop scrollable boolean Whether only the modal body scrolls when content overflows. #}
{# @prop fullscreen boolean|'sm'|'md'|'lg'|'xl'|'xxl' Whether and below which breakpoint the modal fills the viewport. #}
{# @prop backdrop boolean|'static' Whether clicking the backdrop dismisses the modal. #}
{# @prop keyboard boolean Whether pressing Escape dismisses the modal. #}
{# @prop fade boolean Whether to use Bootstrap's fade transition. #}
{# @block content The modal structure, typically `Modal:Header`, `Modal:Body`, and `Modal:Footer`. #}
{%- props id, size = null, centered = false, scrollable = false, fullscreen = false, backdrop = true, keyboard = true, fade = true -%}
{%- set title_id = id ~ '-label' -%}
{%- do provide('modal.titleId', title_id) -%}
{%- set fullscreen_class = fullscreen is same as(true)
    ? 'modal-fullscreen'
    : (fullscreen in ['sm', 'md', 'lg', 'xl', 'xxl'] ? 'modal-fullscreen-' ~ fullscreen ~ '-down' : null)
-%}
{%- set modal_classes = html_classes({
    modal: true,
    fade: fade,
}) -%}
{%- set dialog_classes = html_classes({
    'modal-dialog': true,
    ('modal-' ~ size): size in ['sm', 'lg', 'xl'],
    'modal-dialog-centered': centered,
    'modal-dialog-scrollable': scrollable,
}) -%}
{%- if fullscreen_class is not null -%}
    {%- set dialog_classes = dialog_classes ~ ' ' ~ fullscreen_class -%}
{%- endif -%}
{%- set default_attrs = {
    id: id,
    class: modal_classes,
    tabindex: '-1',
    'aria-labelledby': title_id,
    'aria-hidden': 'true',
} -%}
{%- if backdrop is not same as(true) -%}
    {%- set default_attrs = default_attrs|merge({'data-bs-backdrop': backdrop is same as(false) ? 'false' : 'static'}) -%}
{%- endif -%}
{%- if not keyboard -%}
    {%- set default_attrs = default_attrs|merge({'data-bs-keyboard': 'false'}) -%}
{%- endif -%}
<div {{ attributes.defaults(default_attrs) }}>
    <div class="{{ dialog_classes }}">
        <div class="modal-content">
            {%- block content %}{% endblock -%}
        </div>
    </div>
</div>
