{%- props
    ## 'h1'|'h2'|'h3'|'h4'|'h5'|'h6' The heading element to render.
    tag = 'h6'
-%}
{%- set final_tag = tag in ['h1', 'h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'h6' -%}
<li><{{ final_tag }} {{ attributes.defaults({class: 'dropdown-header'}) }}>
    {##- The dropdown section heading. -#}
    {%- block content %}{% endblock -%}
</{{ final_tag }}></li>
