{%- props
    ## 'button'|'a' The interactive element to render.
    tag = 'button',
    ## 'primary'|'secondary'|'success'|'danger'|'warning'|'info'|'light'|'dark' The Bootstrap contextual color.
    color = 'secondary',
    ## boolean Whether to render the outline variant.
    outline = false,
    ## 'sm'|'lg'|null The optional button size.
    size = null,
    ## boolean Whether to render only the split-menu caret.
    split = false,
    ## boolean Whether the toggle is disabled.
    disabled = false
-%}
{%- set final_tag = tag == 'a' ? 'a' : 'button' -%}
{%- set classes = html_classes({
    btn: true,
    ('btn-' ~ (outline ? 'outline-' : '') ~ color): true,
    ('btn-' ~ size): size in ['sm', 'lg'],
    'dropdown-toggle': true,
    'dropdown-toggle-split': split,
}) -%}
{%- set default_attrs = {
    class: classes,
    'data-bs-toggle': 'dropdown',
    'aria-expanded': 'false',
} -%}
{%- if final_tag == 'button' -%}
    {%- set default_attrs = default_attrs|merge({type: 'button', disabled: disabled}) -%}
{%- else -%}
    {%- set default_attrs = default_attrs|merge({role: 'button'}) -%}
    {%- if disabled -%}
        {%- set default_attrs = default_attrs|merge({'aria-disabled': 'true', tabindex: '-1'}) -%}
    {%- else -%}
        {%- set default_attrs = default_attrs|merge({href: '#'}) -%}
    {%- endif -%}
{%- endif -%}
<{{ final_tag }} {{ attributes.defaults(default_attrs) }}>
    {%- if split %}<span class="visually-hidden">Toggle Dropdown</span>{% else %}
        {##- The visible toggle label. -#}
        {%- block content %}{% endblock -%}
    {% endif -%}
</{{ final_tag }}>
