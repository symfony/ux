{%- props
    ## boolean Whether this item is the currently visible slide.
    active = false,
    ## number|null The item-specific delay in milliseconds before advancing.
    interval = null
-%}
{%- set default_attrs = {
    class: html_classes({'carousel-item': true, active: active}),
} -%}
{%- if interval is not null -%}
    {%- set default_attrs = default_attrs|merge({'data-bs-interval': interval}) -%}
{%- endif -%}
<div {{ attributes.defaults(default_attrs) }}>
    {##- The slide content. -#}
    {%- block content %}{% endblock -%}
</div>
