{%- props
    ## string|null The optional caption displayed below the figure content.
    caption = null,
    ## 'start'|'center'|'end'|null The horizontal alignment of the caption.
    captionAlign = null
-%}
<figure {{ attributes.defaults({class: 'figure'}) }}>
    {##- The figure content, typically a responsive image. -#}
    {%- block content %}{% endblock -%}
    {%- if caption is not null %}
        <figcaption class="{{ html_classes({
            'figure-caption': true,
            ('text-' ~ captionAlign): captionAlign in ['start', 'center', 'end'],
        }) }}">{{ caption }}</figcaption>
    {%- endif %}
</figure>
