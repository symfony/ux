{%- props
    ## string The tooltip content stored by Bootstrap.
    title,
    ## 'auto'|'top'|'right'|'bottom'|'left' The preferred tooltip placement.
    placement = 'top',
    ## boolean Whether the tooltip title contains sanitized HTML.
    html = false,
    ## string|null The custom class applied to the generated tooltip.
    customClass = null
-%}

{%- set final_placement = placement in ['auto', 'top', 'right', 'bottom', 'left'] ? placement : 'top' -%}
{%- set tooltip_trigger_attrs = {
    'data-bs-toggle': 'tooltip',
    'data-bs-title': title,
    'data-bs-placement': final_placement,
}|html_attr_merge -%}
{%- if html -%}
    {%- set tooltip_trigger_attrs = tooltip_trigger_attrs|merge({'data-bs-html': 'true'}) -%}
{%- endif -%}
{%- if customClass not in [null, ''] -%}
    {%- set tooltip_trigger_attrs = tooltip_trigger_attrs|merge({'data-bs-custom-class': customClass}) -%}
{%- endif -%}

{##- The focusable trigger rendering `tooltip_trigger_attrs` with `html_attr()`. -#}
{%- block content %}{% endblock -%}
