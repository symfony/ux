{# @prop title string The tooltip content stored by Bootstrap. #}
{# @prop placement 'auto'|'top'|'right'|'bottom'|'left' The preferred tooltip placement. #}
{# @prop html boolean Whether the tooltip title contains sanitized HTML. #}
{# @prop customClass string|null The custom class applied to the generated tooltip. #}
{# @block content The focusable trigger rendering `tooltip_trigger_attrs` with `html_attr()`. #}
{%- props
    title,
    placement = 'top',
    html = false,
    customClass = null
-%}

{%- set final_placement = placement in ['auto', 'top', 'right', 'bottom', 'left'] ? placement : 'top' -%}
{%- set tooltip_trigger_attrs = {
    'data-bs-toggle': 'tooltip',
    'data-bs-title': title,
    'data-bs-placement': final_placement,
}|html_attr_merge -%}
{%- if html -%}
    {%- set tooltip_trigger_attrs = tooltip_trigger_attrs|merge({'data-bs-html': 'true'}) -%}
{%- endif -%}
{%- if customClass not in [null, ''] -%}
    {%- set tooltip_trigger_attrs = tooltip_trigger_attrs|merge({'data-bs-custom-class': customClass}) -%}
{%- endif -%}

{%- block content %}{% endblock -%}
