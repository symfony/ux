<div class="d-flex flex-wrap gap-3">
    <twig:Tooltip title="Default tooltip on top">
        <twig:Tooltip:Trigger>
            <twig:Button variant="secondary" {{ ...tooltip_trigger_attrs }}>Top</twig:Button>
        </twig:Tooltip:Trigger>
    </twig:Tooltip>
    <twig:Tooltip title="Tooltip on right" placement="right">
        <twig:Tooltip:Trigger>
            <twig:Button variant="secondary" {{ ...tooltip_trigger_attrs }}>Right</twig:Button>
        </twig:Tooltip:Trigger>
    </twig:Tooltip>
    <twig:Tooltip title="Tooltip on bottom" placement="bottom">
        <twig:Tooltip:Trigger>
            <twig:Button variant="secondary" {{ ...tooltip_trigger_attrs }}>Bottom</twig:Button>
        </twig:Tooltip:Trigger>
    </twig:Tooltip>
    <twig:Tooltip title="Tooltip on left" placement="left">
        <twig:Tooltip:Trigger>
            <twig:Button variant="secondary" {{ ...tooltip_trigger_attrs }}>Left</twig:Button>
        </twig:Tooltip:Trigger>
    </twig:Tooltip>
</div>