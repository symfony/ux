<twig:Collapse id="myCollapse">
    <twig:Collapse:Trigger>
        <twig:Button class="mb-2" {{ ...collapse_trigger_attrs }}>Toggle</twig:Button>
    </twig:Collapse:Trigger>
    <twig:Collapse:Content>
        <div class="card card-body">Collapsible content goes here.</div>
    </twig:Collapse:Content>
</twig:Collapse>