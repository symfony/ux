<twig:Collapse id="collapseOpen" open>
    <twig:Collapse:Trigger>
        <twig:Button variant="outline-primary" class="mb-2" {{ ...collapse_trigger_attrs }}>
            Toggle content
        </twig:Button>
    </twig:Collapse:Trigger>
    <twig:Collapse:Content>
        <div class="card card-body">
            This content is visible by default and can be hidden by clicking the trigger.
        </div>
    </twig:Collapse:Content>
</twig:Collapse>