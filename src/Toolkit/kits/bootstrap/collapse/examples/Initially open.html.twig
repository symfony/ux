<twig:Collapse:Trigger target="#collapseOpen" expanded class="btn btn-outline-primary mb-2">
    Toggle content
</twig:Collapse:Trigger>
<twig:Collapse id="collapseOpen" open>
    <div class="card card-body">
        This content is visible by default and can be hidden by clicking the trigger.
    </div>
</twig:Collapse>
