{# @prop id string Unique identifier for the collapsible element #}
{# @prop open bool Whether the content is visible by default. Defaults to `false` #}
{# @prop horizontal bool Whether to collapse horizontally instead of vertically. Defaults to `false` #}
{# @block content The collapsible content #}
{%- props id, open = false, horizontal = false -%}
{%- set style = html_cva(
    base: 'collapse',
    variants: {
        open: {
            true: 'show',
        },
        horizontal: {
            true: 'collapse-horizontal',
        },
    },
) -%}
<div
    class="{{ style.apply({open, horizontal}, attributes.render('class')) }}"
    id="{{ id }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
