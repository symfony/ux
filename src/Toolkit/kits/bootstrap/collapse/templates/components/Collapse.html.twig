{%- props
    ## string The unique identifier targeted by collapse controls.
    id,
    ## boolean Whether the collapsible content is initially visible.
    show = false,
    ## boolean Whether the width is collapsed instead of the height.
    horizontal = false
-%}
<div {{ attributes.defaults({
    id: id,
    class: html_classes({
        collapse: true,
        'collapse-horizontal': horizontal,
        show: show,
    }),
}) }}>
    {##- The content shown and hidden by the collapse control. -#}
    {%- block content %}{% endblock -%}
</div>
