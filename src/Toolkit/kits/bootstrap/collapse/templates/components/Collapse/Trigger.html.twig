{# @block content The trigger element that toggles the collapsible content #}
{%- set collapse_trigger_attrs = {
    'data-action': 'click->collapse#toggle'|html_attr_type('sst'),
    'data-collapse-target': 'trigger',
    'aria-expanded': _collapse_is_open ? 'true' : 'false',
    'aria-controls': _collapse_id ~ '-content',
} -%}
{%- block content %}{% endblock -%}