{# @prop target string The CSS selector of the collapse target (e.g. `#myCollapse`) #}
{# @prop expanded bool Whether the target is initially expanded. Defaults to `false` #}
{# @prop as 'button' The HTML tag to render. Defaults to `button` #}
{# @block content The trigger label #}
{%- props target, expanded = false, as = 'button' -%}
<{{ as }}
    data-bs-toggle="collapse"
    {% if as == 'a' %}href="{{ target }}"{% else %}data-bs-target="{{ target }}"{% endif %}
    aria-expanded="{{ expanded ? 'true' : 'false' }}"
    aria-controls="{{ target|replace({'#': '', '.': ''}) }}"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</{{ as }}>
