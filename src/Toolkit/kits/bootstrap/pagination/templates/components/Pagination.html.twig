{%- props
    ## 'sm'|'lg'|null The pagination control size.
    size = null,
    ## 'start'|'center'|'end'|null The horizontal alignment of the pagination links.
    align = null,
    ## string The accessible name of the navigation landmark.
    ariaLabel = 'Pagination'
-%}

{%- set pagination_classes = html_classes('pagination', {
    ('pagination-' ~ size): size in ['sm', 'lg'],
    ('justify-content-' ~ align): align in ['start', 'center', 'end'],
}) -%}

<nav {{ attributes.defaults({'aria-label': ariaLabel}) }}>
    <ul class="{{ pagination_classes }}">
        {##- The pagination items, typically `Pagination:Item` components. -#}
        {%- block content -%}{% endblock -%}
    </ul>
</nav>
