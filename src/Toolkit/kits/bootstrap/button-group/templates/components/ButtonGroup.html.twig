{%- props
    ## boolean Whether to stack the buttons vertically.
    vertical = false,
    ## 'sm'|'lg'|null The Bootstrap size applied to every button in the group.
    size = null,
    ## string|null The accessible name for the group.
    label = 'Button group'
-%}

{%- set classes = html_classes({
    (vertical ? 'btn-group-vertical' : 'btn-group'): true,
    ('btn-group-' ~ size): size in ['lg', 'sm'],
}) -%}
{%- set default_attrs = {class: classes, role: 'group'} -%}
{%- if label not in [null, ''] -%}
    {%- set default_attrs = default_attrs|merge({'aria-label': label}) -%}
{%- endif -%}

<div {{ attributes.defaults(default_attrs) }}>
    {##- The buttons, links, or form controls contained in the group. -#}
    {%- block content -%}{%- endblock -%}
</div>
