{# @prop orientation 'horizontal'|'vertical' The layout direction. Defaults to `horizontal` #}
{# @prop size 'default'|'sm'|'lg' The size of all buttons in the group. Defaults to `default` #}
{# @block content The grouped buttons #}
{%- props orientation = 'horizontal', size = 'default' -%}
{%- set style = html_cva(
    base: '',
    variants: {
        orientation: {
            horizontal: 'btn-group',
            vertical: 'btn-group-vertical',
        },
        size: {
            default: '',
            sm: 'btn-group-sm',
            lg: 'btn-group-lg',
        },
    },
) -%}
<div
    class="{{ style.apply({orientation, size}, attributes.render('class')) }}"
    role="group"
    {{ attributes }}
>
    {%- block content %}{% endblock -%}
</div>
