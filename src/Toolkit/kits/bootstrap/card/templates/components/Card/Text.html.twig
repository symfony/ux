{# @prop tag 'p'|'div' The HTML element to render. #}
{# @block content The supporting text of the card. #}
{%- props tag = 'p' -%}
{%- set final_tag = tag == 'div' ? 'div' : 'p' -%}
<{{ final_tag }} {{ attributes.defaults({class: 'card-text'}) }}>
    {%- block content %}{% endblock -%}
</{{ final_tag }}>
