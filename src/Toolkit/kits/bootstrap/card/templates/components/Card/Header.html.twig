{%- props
    ## 'div'|'h2'|'h3'|'h4'|'h5'|'h6' The HTML element to render.
    tag = 'div'
-%}
{%- set final_tag = tag in ['h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'div' -%}
<{{ final_tag }} {{ attributes.defaults({class: 'card-header'}) }}>
    {##- The header content of the card. -#}
    {%- block content %}{% endblock -%}
</{{ final_tag }}>
