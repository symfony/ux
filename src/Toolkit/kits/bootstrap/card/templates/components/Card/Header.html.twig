{# @prop tag 'div'|'h2'|'h3'|'h4'|'h5'|'h6' The HTML element to render. #}
{# @block content The header content of the card. #}
{%- props tag = 'div' -%}
{%- set final_tag = tag in ['h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'div' -%}
<{{ final_tag }} {{ attributes.defaults({class: 'card-header'}) }}>
    {%- block content %}{% endblock -%}
</{{ final_tag }}>
