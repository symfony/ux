{# @prop src string The image source URL. #}
{# @prop alt string A text alternative describing the image. #}
{# @prop position 'top'|'bottom'|'background' The image position within the card. #}
{%- props src, alt = '', position = 'top' -%}
{%- set classes = {
    top: 'card-img-top',
    bottom: 'card-img-bottom',
    background: 'card-img',
} -%}
<img {{ attributes.defaults({
    src: src,
    alt: alt,
    class: classes[position] ?? classes.top,
}) }}>
