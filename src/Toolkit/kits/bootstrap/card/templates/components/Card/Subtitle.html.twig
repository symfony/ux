{# @prop tag 'h2'|'h3'|'h4'|'h5'|'h6'|'div' The HTML element to render. #}
{# @block content The subtitle text of the card. #}
{%- props tag = 'h6' -%}
{%- set final_tag = tag in ['h2', 'h3', 'h4', 'h5', 'h6'] ? tag : 'div' -%}
<{{ final_tag }} {{ attributes.defaults({class: 'card-subtitle'}) }}>
    {%- block content %}{% endblock -%}
</{{ final_tag }}>
