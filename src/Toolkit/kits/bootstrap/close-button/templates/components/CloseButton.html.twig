{%- props
    ## boolean Whether the close button is disabled.
    disabled = false,
    ## string The accessible label describing the close action.
    label = 'Close'|trans
-%}
{%- set default_attrs = {
    type: 'button',
    class: 'btn-close',
    'aria-label': label,
} -%}
{%- if disabled -%}
    {%- set default_attrs = default_attrs|merge({disabled: true}) -%}
{%- endif -%}
<button {{ attributes.defaults(default_attrs) }}></button>
