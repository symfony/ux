{%- props
    ## 'ul'|'nav'|'div' The HTML element used for the navigation container.
    tag = 'ul',
    ## 'tabs'|'pills'|'underline'|null The Bootstrap navigation style.
    type = null,
    ## boolean Whether items proportionally fill the available width.
    fill = false,
    ## boolean Whether items use equal widths.
    justified = false,
    ## boolean Whether items are stacked vertically.
    vertical = false,
    ## 'start'|'center'|'end'|null The horizontal alignment of the navigation items.
    align = null,
    ## string|null The ARIA role applied to the navigation container.
    role = null
-%}

{%- set final_tag = tag in ['nav', 'div'] ? tag : 'ul' -%}
{%- set nav_classes = html_classes({
    nav: true,
    ('nav-' ~ type): type in ['tabs', 'pills', 'underline'],
    'nav-fill': fill,
    'nav-justified': justified,
    'flex-column': vertical,
    ('justify-content-' ~ align): align in ['start', 'center', 'end'],
}) -%}
{%- set default_attrs = {class: nav_classes} -%}
{%- if role not in [null, ''] -%}
    {%- set default_attrs = default_attrs|merge({role: role}) -%}
{%- endif -%}

<{{ final_tag }} {{ attributes.defaults(default_attrs) }}>
    {##- The navigation links or `Nav:Item` components. -#}
    {%- block content -%}{% endblock -%}
</{{ final_tag }}>
