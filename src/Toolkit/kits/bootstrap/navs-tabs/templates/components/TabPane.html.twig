{%- props
    ## string The unique identifier targeted by a tab control.
    id,
    ## string|null The identifier of the tab control labelling the panel.
    labelledBy = null,
    ## boolean Whether the panel is initially visible.
    active = false,
    ## boolean Whether the panel uses Bootstrap's fade transition.
    fade = false
-%}

{%- set pane_classes = html_classes('tab-pane', {
    fade: fade,
    show: fade and active,
    active: active,
}) -%}
{%- set default_attrs = {
    class: pane_classes,
    id: id,
    role: 'tabpanel',
    tabindex: '0',
} -%}
{%- if labelledBy not in [null, ''] -%}
    {%- set default_attrs = default_attrs|merge({'aria-labelledby': labelledBy}) -%}
{%- endif -%}

<div {{ attributes.defaults(default_attrs) }}>
    {##- The tab panel content. -#}
    {%- block content -%}{% endblock -%}
</div>
