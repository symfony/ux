{
    "name": "@symfony/ux-icons",
    "description": "Render Symfony UX Icons in JavaScript, React and Vue",
    "license": "MIT",
    "version": "3.5.1",
    "keywords": [
        "symfony-ux",
        "icons",
        "svg"
    ],
    "homepage": "https://ux.symfony.com/icons",
    "repository": "https://github.com/symfony/ux",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "default": "./dist/react.js"
        },
        "./vue": {
            "types": "./dist/vue.d.ts",
            "default": "./dist/vue.js"
        }
    },
    "config": {
        "tests": {
            "peerDependencyVersions": [
                {
                    "react": "^18.0",
                    "react-dom": "^18.0",
                    "vue": "^3.0"
                },
                {
                    "react": "^19.0",
                    "react-dom": "^19.0",
                    "vue": "^3.0"
                }
            ]
        }
    },
    "scripts": {
        "build": "node ../../../bin/build_package.ts .",
        "watch": "node ../../../bin/build_package.ts . --watch",
        "test": "pnpm run test:unit",
        "test:unit": "../../../bin/unit_test_package.sh ."
    },
    "symfony": {
        "importmap": {
            "@symfony/ux-icons": "path:%PACKAGE%/dist/index.js",
            "@symfony/ux-icons/react": "path:%PACKAGE%/dist/react.js",
            "@symfony/ux-icons/vue": "path:%PACKAGE%/dist/vue.js"
        }
    },
    "peerDependencies": {
        "react": "^18.0 || ^19.0",
        "vue": "^3.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "vue": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.0",
        "@testing-library/jest-dom": "^6.6.3",
        "@types/react": "^18.0 || ^19.0",
        "@types/react-dom": "^18.0 || ^19.0",
        "jsdom": "^26.1.0",
        "react": "^18.0 || ^19.0",
        "react-dom": "^18.0 || ^19.0",
        "tslib": "^2.8.1",
        "typescript": "^5.8.3",
        "vitest": "^4.1.0",
        "vue": "^3.0"
    }
}
