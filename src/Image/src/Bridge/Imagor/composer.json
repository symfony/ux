{
    "name": "symfony/ux-imagor-image",
    "type": "symfony-ux-image-bridge",
    "description": "Symfony UX Image Imagor Bridge",
    "keywords": [
        "symfony-ux",
        "imagor",
        "image",
        "responsive"
    ],
    "homepage": "https://symfony.com",
    "license": "MIT",
    "authors": [
        {
            "name": "Symfony Community",
            "homepage": "https://symfony.com/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "symfony/ux-image": "^3.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "spatie/phpunit-snapshot-assertions": "^5.2.3"
    },
    "autoload": {
        "psr-4": {
            "Symfony\\UX\\Image\\Bridge\\Imagor\\": "src/"
        },
        "exclude-from-classmap": []
    },
    "autoload-dev": {
        "psr-4": {
            "Symfony\\UX\\Image\\Bridge\\Imagor\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev"
}
