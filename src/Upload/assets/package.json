{
    "name": "@symfony/ux-upload",
    "description": "Direct and resumable file uploads for Symfony applications",
    "license": "MIT",
    "version": "3.7.2",
    "keywords": [
        "chunked",
        "file",
        "stimulus",
        "symfony-ux",
        "upload"
    ],
    "homepage": "https://ux.symfony.com/upload",
    "repository": "https://github.com/symfony/ux",
    "type": "module",
    "files": [
        "dist"
    ],
    "main": "dist/upload_controller.js",
    "types": "dist/upload_controller.d.ts",
    "config": {
        "css_source": "src/style.css"
    },
    "scripts": {
        "build": "node ../../../bin/build_package.ts .",
        "watch": "node ../../../bin/build_package.ts . --watch",
        "test": "pnpm run test:unit && pnpm run test:browser",
        "test:unit": "../../../bin/unit_test_package.sh .",
        "test:browser": "playwright test",
        "test:browser:ui": "playwright test --ui"
    },
    "symfony": {
        "controllers": {
            "upload": {
                "main": "dist/upload_controller.js",
                "webpackMode": "eager",
                "fetch": "eager",
                "enabled": true,
                "autoimport": {
                    "@symfony/ux-upload/dist/style.min.css": false
                }
            },
            "live-upload": {
                "main": "dist/live_upload_controller.js",
                "webpackMode": "lazy",
                "fetch": "lazy",
                "enabled": true
            }
        },
        "importmap": {
            "@hotwired/stimulus": "^3.0.0",
            "@symfony/ux-upload": "path:%PACKAGE%/dist/upload_controller.js"
        }
    },
    "peerDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@symfony/ux-live-component": "^3.0"
    },
    "peerDependenciesMeta": {
        "@symfony/ux-live-component": {
            "optional": true
        }
    },
    "devDependencies": {
        "@hotwired/stimulus": "^3.0.0",
        "@symfony/ux-live-component": "^3.0"
    }
}
