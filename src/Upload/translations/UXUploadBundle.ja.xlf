                <source>ux_upload.announce_paused</source>
                <target>%filename%: アップロード一時停止</target>
            </trans-unit>
            <trans-unit id="announce_resumed" resname="ux_upload.announce_resumed">
                <source>ux_upload.announce_resumed</source>
                <target>%filename%: アップロード再開</target>
