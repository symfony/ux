<!DOCTYPE html>
<html lang="en"{% if color_scheme %} style="color-scheme: {{ color_scheme }}"{% endif %}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>UX Upload E2E</title>
    <link rel="icon" href="data:,">
    {% if stylesheet %}<link rel="stylesheet" href="/assets/dist/{{ stylesheet }}">{% endif %}
    <script type="importmap">
    {
        "imports": {
            "@hotwired/stimulus": "/assets/stimulus.js"
        }
    }
    </script>
    <script type="module">
        import { Application, Controller } from '@hotwired/stimulus';
        import UploadController from '/assets/dist/upload_controller.js';

        const application = Application.start();
        application.register('symfony--ux-upload--upload', UploadController);
        application.register('test-widget', class extends Controller {
            connect() {
                this.element.dataset.testWidgetConnected = 'true';
            }
        });

        // Signal to the test that Stimulus has booted and the controller is registered.
        document.documentElement.dataset.uxUploadReady = 'true';
        window.__uxUploadReady = true;
    </script>
</head>
<body>
    <h1>Upload Test</h1>
    {% if theme %}{% form_theme upload_field theme %}{% endif %}
    {{ form_start(form) }}
        {{ render_row ? form_row(upload_field) : form_widget(upload_field) }}
        <button type="submit">Save</button>
    {{ form_end(form) }}
</body>
</html>
