{% block dropzone_widget -%}
    {%- set data_controller = (attr['data-controller']|default('') ~ ' symfony--ux-dropzone--dropzone')|trim -%}
    {%- set placeholder = attr.placeholder ?? false -%}
    {#- "placeholder" is not a valid attribute of <input type="file"> -#}
    {%- set attr = attr|filter((value, name) => name != 'placeholder')|merge({'data-controller': '', class: (attr.class|default('') ~ ' dropzone-input')|trim}) -%}
    {%- set remove_label_translated = translation_domain is same as(false) ? remove_label : remove_label|trans({}, translation_domain) -%}

    <div class="dropzone-container{% if multiple %} dropzone-container-multiple{% endif %}" data-controller="{{ data_controller }}"{% if multiple %} data-symfony--ux-dropzone--dropzone-multiple-value="true" data-symfony--ux-dropzone--dropzone-remove-label-value="{{ remove_label_translated }}"{% if max_files is not null %} data-symfony--ux-dropzone--dropzone-max-files-value="{{ max_files }}"{% endif %}{% endif %}>
        <input type="file" {{ block('widget_attributes') }} data-symfony--ux-dropzone--dropzone-target="input" />

        <div class="dropzone-placeholder" data-symfony--ux-dropzone--dropzone-target="placeholder">
            {%- if placeholder is not same as(false) -%}
                {#- A translatable object is always translated, with its own domain -#}
                {{- placeholder.trans is defined ? placeholder|trans : (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) -}}
            {%- endif -%}
        </div>

        <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview" hidden>
            <button class="dropzone-preview-button" type="button"
                    data-symfony--ux-dropzone--dropzone-target="previewClearButton"></button>

            <div class="dropzone-preview-image" hidden
                 data-symfony--ux-dropzone--dropzone-target="previewImage"></div>

            <div data-symfony--ux-dropzone--dropzone-target="previewFilename" class="dropzone-preview-filename"></div>
        </div>
{% if multiple %}
        <ul class="dropzone-preview-list" data-symfony--ux-dropzone--dropzone-target="previewList"></ul>
{{ block('dropzone_preview_item_template') }}
{% endif %}
    </div>
{%- endblock %}

{% block dropzone_preview_item_template %}{% endblock %}
