{% block dropzone_widget -%}
    {#- A "data-controller" passed to form_widget() is only in "attr", and the label is translated in the locale of the rendering -#}
    {%- set container_attr = container_attr|merge({'data-controller': (attr['data-controller']|default('') ~ ' symfony--ux-dropzone--dropzone')|trim}) -%}
    {%- for name, text in {'remove-label': remove_label, 'accept-message': accept_message, 'max-files-message': max_files_message} -%}
        {%- if text is not same as(false) -%}
            {%- set container_attr = container_attr|merge({('data-symfony--ux-dropzone--dropzone-' ~ name ~ '-value'): text.trans is defined ? text|trans : (translation_domain is same as(false) ? text : text|trans({}, translation_domain))}) -%}
        {%- endif -%}
    {%- endfor -%}
    {#- "form.vars" keeps the values of buildView(): a placeholder passed in "attr" to form_widget() still wins, as in older versions -#}
    {%- set placeholder = (attr.placeholder ?? false) is same as(form.vars.attr.placeholder ?? false) ? placeholder : attr.placeholder -%}
    {#- "placeholder" is not a valid attribute of <input type="file"> -#}
    {%- set attr = attr|filter((value, name) => name != 'placeholder' and name != 'data-controller')|merge({class: (attr.class|default('') ~ ' dropzone-input')|trim}) -%}

    <div{% with {attr: container_attr} %}{{ block('attributes') }}{% endwith %}>
        <input type="file" {{ block('widget_attributes') }} data-symfony--ux-dropzone--dropzone-target="input" />

        <div class="dropzone-placeholder" data-symfony--ux-dropzone--dropzone-target="placeholder">
            {%- if placeholder is not same as(false) -%}
                {#- A translatable object is always translated, with its own domain -#}
                {{- placeholder.trans is defined ? placeholder|trans : (translation_domain is same as(false) ? placeholder : placeholder|trans({}, translation_domain)) -}}
            {%- endif -%}
        </div>

        <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview" hidden>
            <button class="dropzone-preview-button" type="button"
                    data-symfony--ux-dropzone--dropzone-target="previewClearButton"></button>

            <div class="dropzone-preview-image" hidden
                 data-symfony--ux-dropzone--dropzone-target="previewImage"></div>

            <div data-symfony--ux-dropzone--dropzone-target="previewFilename" class="dropzone-preview-filename"></div>
        </div>
{% if multiple %}
        <ul class="dropzone-preview-list" data-symfony--ux-dropzone--dropzone-target="previewList"></ul>
{% endif %}
{{- block('dropzone_preview_item_template') }}
{% if accept_message is not same as(false) or max_files_message is not same as(false) %}
        <div class="dropzone-feedback" role="status" data-symfony--ux-dropzone--dropzone-target="feedback"></div>
{% endif %}
    </div>
{%- endblock %}

{% block dropzone_preview_item_template %}{% endblock %}
