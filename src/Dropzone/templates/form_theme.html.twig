{% block dropzone_widget -%}
    {%- set dataController = (attr['data-controller']|default('') ~ ' symfony--ux-dropzone--dropzone')|trim -%}
    {%- set attr = attr|merge({'data-controller': '', class: (attr.class|default('') ~ ' dropzone-input')|trim}) -%}

    {%- if preview.style == 'legacy' -%}
    <div class="dropzone-container" data-controller="{{ dataController }}">
        <input type="file" {{ block('widget_attributes') }} data-symfony--ux-dropzone--dropzone-target="input" />

        <div class="dropzone-placeholder" data-symfony--ux-dropzone--dropzone-target="placeholder">
            {%- if attr.placeholder is defined and attr.placeholder is not none -%}
                {{- translation_domain is same as(false) ? attr.placeholder : attr.placeholder|trans({}, translation_domain) -}}
            {%- endif -%}
        </div>

        <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview" style="display: none">
            <button class="dropzone-preview-button" type="button"
                    data-symfony--ux-dropzone--dropzone-target="previewClearButton"></button>

            <div class="dropzone-preview-image" style="display: none"
                 data-symfony--ux-dropzone--dropzone-target="previewImage"></div>

            <div data-symfony--ux-dropzone--dropzone-target="previewFilename" class="dropzone-preview-filename"></div>
        </div>
    </div>
    {%- else -%}
    <div 
        class="
            dropzone-container             
            dropzone-{{ preview.style }}            
            dropzone-preview-container-hidden
            {{ preview.can_open_file_picker? 'dropzone-preview-can-open-file-picker' : '' }}
        "
        data-controller="{{ dataController }}" 
        data-symfony--ux-dropzone--dropzone-options-value="{{ controller_options|json_encode|e('html_attr') }}" 
    >
        <label class="dropzone-placeholder" for="{{ id }}" data-symfony--ux-dropzone--dropzone-target="placeholder">            
            {%- if attr.placeholder is defined and attr.placeholder is not none -%}
                {{- translation_domain is same as(false) ? attr.placeholder : attr.placeholder|trans({}, translation_domain) -}}
            {%- endif -%}
            <input class="dropzone-input" type="file" {{ block('widget_attributes') }} data-symfony--ux-dropzone--dropzone-target="input">
        </label>
        <div class="dropzone-preview-container" data-symfony--ux-dropzone--dropzone-target="previewContainer">
            {%- block preview_template -%}
            <template data-symfony--ux-dropzone--dropzone-target="previewTemplate">
                <div class="dropzone-preview" data-symfony--ux-dropzone--dropzone-target="preview">
                    {%- block preview_image -%}
                    <div class="dropzone-preview-image">                        
                        <svg class="dropzone-preview-image-placeholder" xmlns="https://www.w3.org/2000/svg" viewBox="0 0 24 24"><path fill="none" stroke="#d1d5dc" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9"/></svg>                        
                    </div>
                    {%- endblock -%}
                    {%- block preview_meta -%}
                    <div class="dropzone-preview-meta">
                        <div class="dropzone-preview-filename"></div>
                        <div class="dropzone-preview-file-size"></div>
                    </div>
                    {%- endblock -%}
                    {%- block preview_button -%}                            
                    <button class="dropzone-preview-button" type="button">                        
                        <svg xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>                        
                    </button> 
                    {%- endblock -%}
                </div>
            </template>
            {%- endblock -%}
        </div>
    </div>
    {%- endif -%}
{%- endblock %}
