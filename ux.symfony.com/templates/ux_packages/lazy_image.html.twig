{% extends 'base.html.twig' %}

{% set meta = {
    title: package.humanName ~ ' - Symfony UX 2',
    description: package.description,
    canonical: url(package.route),
    social: {
        title: package.tagline ~ ' - Symfony UX 2' ~ package.humanName|u.trimStart('UX '),
        description: package.description|striptags,
        image: {
            url: absolute_url(asset(package.getSocialImage('1200x675'))),
            type: 'image/png',
            width: 1200,
            height: 675,
            alt: package.humanName ~ ' - Component Icon',
        },
    }
} %}

{% block main %}
    <main class="deprecated-package">
        <div class="">
            <p class="deprecated-badge">Deprecated Package</p>
            <h1 class="mb-4">UX LazyImage 2.x</h1>
            <p>This component is <strong>deprecated</strong> and will not receive further updates.<br>
                Instead, use the <a href="https://web.dev/learn/images/performance-issues" class="link">modern techniques to improve image loading performance</a>
                natively supported by all major browsers.</p>
        </div>
    </main>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .deprecated-package {
            display: grid;
            place-content: center;
            text-align: center;
            padding-top: 5rem;
            max-width: 36rem;
            margin-block: auto;
            align-self: center;
        }
        .deprecated-badge {
            opacity: 0.85;
            background: orange;
            display: inline-block;
            padding: .1rem .6rem;
            border-radius: .1rem;
            box-shadow: 0 0 -3px 4px rgb(0 0 0 / .1);
            color: #000;
            font-size: .875rem;
            text-shadow: 0 1px 4px #fff;
            transform-origin: center;
            transform: translateY(0rem) rotate(11deg) translateX(8rem);
        }
    </style>
{% endblock %}
