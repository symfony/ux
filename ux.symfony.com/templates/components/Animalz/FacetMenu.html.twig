<div {{ attributes }}>
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Filters</span>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-live-action="reset">Reset</button>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="facet-name" class="form-label">Name</label>
                <input
                    type="text"
                    id="facet-name"
                    class="form-control"
                    data-model="name"
                    placeholder="Search by name..."
                >
            </div>
            <div class="mb-3">
                <label for="facet-type" class="form-label">Type</label>
                <select id="facet-type" class="form-select" data-model="type">
                    <option value="">All types</option>
                    {% for type in this.typeChoices %}
                        <option value="{{ type.value }}">{{ type.value }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="mb-3">
                <label for="facet-legs" class="form-label">
                    Max legs: <strong>{{ this.maxLegs ?? this.legsMax }}</strong>
                </label>
                <input
                    type="range"
                    id="facet-legs"
                    class="form-range"
                    data-model="maxLegs"
                    min="0"
                    max="{{ this.legsMax }}"
                    value="{{ this.maxLegs ?? this.legsMax }}"
                >
            </div>
        </div>
    </div>
</div>
