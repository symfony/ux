{%- props
    ## 'default'|'secondary'|'destructive'|'outline'|'ghost'|'link' The visual style variant.
    variant = 'default',
    ## 'span'|'a' The HTML tag to render; use `a` when the badge navigates.
    as = 'span'
-%}
{%- set style = cva(
    base: {
        display: 'inline-flex', h: '5', w: 'fit', flexShrink: '0', alignItems: 'center', justifyContent: 'center', gap: '1',
        overflow: 'hidden', rounded: '4xl', borderWidth: '1px', borderColor: 'transparent', px: '2', py: '0.5',
        fontSize: 'xs', fontWeight: 'medium', whiteSpace: 'nowrap', transition: 'all',
        _focusVisible: {borderColor: 'ring', boxShadow: '[0 0 0 3px color-mix(in oklab, var(--ring) 50%, transparent)]'},
        '&:has([data-icon=inline-end])': {pe: '1.5'},
        '&:has([data-icon=inline-start])': {ps: '1.5'},
        _invalid: {
            borderColor: 'destructive',
            boxShadow: '[0 0 0 3px color-mix(in oklab, var(--destructive) 20%, transparent)]',
            _dark: {boxShadow: '[0 0 0 3px color-mix(in oklab, var(--destructive) 40%, transparent)]'},
        },
        '& > svg': {pointerEvents: 'none', boxSize: '3!'},
    },
    variants: {
        variant: {
            default: {bg: 'primary', color: 'primary.foreground', '&:is(a):hover': {bg: 'primary/80'}},
            secondary: {bg: 'secondary', color: 'secondary.foreground', '&:is(a):hover': {bg: 'secondary/80'}},
            destructive: {
                bg: 'destructive/10', color: 'destructive',
                _focusVisible: {boxShadow: '[0 0 0 3px color-mix(in oklab, var(--destructive) 20%, transparent)]'},
                _dark: {bg: 'destructive/20', _focusVisible: {boxShadow: '[0 0 0 3px color-mix(in oklab, var(--destructive) 40%, transparent)]'}},
                '&:is(a):hover': {bg: 'destructive/20'},
            },
            outline: {borderColor: 'border', color: 'foreground', '&:is(a):hover': {bg: 'muted', color: 'muted.foreground'}},
            ghost: {_hover: {bg: 'muted', color: 'muted.foreground'}, _dark: {_hover: {bg: 'muted/50'}}},
            link: {color: 'primary', textUnderlineOffset: '4px', _hover: {textDecoration: 'underline'}},
        },
    },
) -%}
<{{ as }}
    data-slot="badge"
    data-variant="{{ variant }}"
    {{ attributes.defaults({
        class: style.apply({variant: variant}),
    }) }}
>
    {##- The badge label or content. -#}
    {%- block content %}{% endblock -%}
</{{ as }}>
