{% if pages > 1 %}
    <nav class="pagination" aria-label="Clients">
        <a
            class="pagination__link"
            data-turbo-frame="clients_frame"
            href="{{ path('home', {page: page - 1}) }}"
            {% if page <= 1 %}aria-disabled="true" tabindex="-1"{% endif %}
        >&lsaquo; Previous</a>
        <span class="pagination__indicator">Page {{ page }} / {{ pages }}</span>
        <a
            class="pagination__link"
            data-turbo-frame="clients_frame"
            href="{{ path('home', {page: page + 1}) }}"
            {% if page >= pages %}aria-disabled="true" tabindex="-1"{% endif %}
        >Next &rsaquo;</a>
    </nav>
{% endif %}
