{% for client in clients %}
    <twig:ux:disclose :context="client" toggle class="client-card">
        {% block button %}
            <span class="client-card__name">{{ client.name }}</span>
            <button
                type="button"
                class="client-card__toggle"
                data-disclose-target="button"
                data-action="disclose#toggle:stop"
                aria-label="Reveal contact"
                title="Reveal contact"
            >
                <svg class="disclose-icon disclose-icon--eye-slash" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/><line x1="2" y1="2" x2="22" y2="22"/></svg>
                <svg class="disclose-icon disclose-icon--eye" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
                <span class="disclose-spinner" aria-hidden="true"></span>
            </button>
        {% endblock %}

        {% block content %}
            <span class="client-card__contact" data-disclose-target="value">••••••••@•••••••&nbsp;&nbsp;·&nbsp;&nbsp;••••••••</span>
        {% endblock %}

        {# Rendered server-side by the disclose endpoint, on click, with the
           resolved "subject" (the Client). The block is compiled into the
           component tag's embedded module and never reaches the initial page
           HTML, so the contact details stay masked until the signed, rate-limited
           endpoint renders it. #}
        {% block reveal %}
            <span class="client-card__detail">{{ subject.email }}</span>
            <span class="client-card__sep" aria-hidden="true">·</span>
            <span class="client-card__detail">{{ subject.phone }}</span>
        {% endblock %}

        {% block error %}
            <p class="client-card__error" data-disclose-target="error" role="alert" hidden></p>
        {% endblock %}
    </twig:ux:disclose>
{% else %}
    <p class="empty-state">No clients yet. Run <code>php bin/console app:seed-clients</code>.</p>
{% endfor %}
