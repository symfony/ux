{% extends 'example.html.twig' %}

{% block example %}
    <div>
        <h2>Turbo Stream Redirect Demo</h2>
        <p>Submit the form to be redirected by a Turbo Stream, without a full page reload.</p>

        <div id="form-container">
            <form method="POST" action="{{ path('app_ux_turbo_stream_redirect') }}">
                <button type="submit" class="btn btn-primary" id="submit-turbo-stream-redirect">
                    Submit form
                </button>
            </form>
        </div>
    </div>
{% endblock %}
