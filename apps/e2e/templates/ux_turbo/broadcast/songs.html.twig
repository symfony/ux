{% extends 'example.html.twig' %}

{% block example %}
    <twig:Turbo:Stream:From topics="songs" />

    <h2 class="h4 mb-3">Turbo Broadcast — Songs</h2>

    <div class="row g-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Live list</div>
                <div class="card-body">
                    <div id="songs-list"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Create / update / remove</div>
                <div class="card-body">
                    <form method="post" enctype="application/x-www-form-urlencoded">
                        <div class="mb-3">
                            <label for="song-id" class="form-label">ID</label>
                            <input id="song-id" class="form-control" placeholder="ID" name="id">
                        </div>
                        <div class="mb-3">
                            <label for="song-title" class="form-label">Title</label>
                            <input id="song-title" class="form-control" placeholder="Title" name="title">
                        </div>
                        <div class="mb-3">
                            <label for="song-artist-id" class="form-label">Artist ID</label>
                            <input id="song-artist-id" class="form-control" placeholder="Artist ID" name="artistId">
                        </div>
                        <div class="form-check mb-3">
                            <input id="song-remove" class="form-check-input" type="checkbox" name="remove" value="remove">
                            <label class="form-check-label" for="song-remove">Remove</label>
                        </div>
                        <button id="song-submit" type="submit" class="btn btn-primary">Submit</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
