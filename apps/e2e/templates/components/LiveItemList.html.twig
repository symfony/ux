<div{{ attributes }}>
    <div class="d-flex gap-2 mb-2">
        <button
            type="button"
            class="btn btn-primary "
            {{ live_action('addItem') }}
        >Add item</button>

        <button
            type="button"
            class="btn btn-danger"
            {{ live_action('deleteItems') }}
        >Delete all</button>
    </div>

    {% if items|length > 0 %}
        <ul class="list-group" style="--bs-list-group-item-padding-y: .5rem; --bs-list-group-item-padding-x: .5rem;">
            {% for key, item in items %}
                <li key="{{ key }}" class="list-group-item d-flex align-items-center gap-2">
                    <label for="item-{{ key }}" class="text-nowrap fw-bold">Item #{{ key }}</label>
                    <input id="item-{{ key }}" data-model="debounce(250)|items.{{ key }}" value="{{ item }}" class="form-control"/>
                    <button
                        type="button"
                        class="btn btn-danger btn-sm"
                        title="Delete item #{{ key }}"
                        {{ live_action('deleteItem', {key: key}) }}
                    >Delete</button>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <div class="alert alert-info">No items.</div>
    {% endif %}
</div>
