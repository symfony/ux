<div{{ attributes }}>
    <button
        type="button"
        class="btn btn-primary"
        {{ this.canAddAddress ? '' : 'disabled' }}
        {{ live_action('addAddress') }}
    >Add address</button>
    <button
        type="button"
        class="btn btn-danger"
        {{ live_action('reset') }}
    >Reset</button>

    <hr>
    <h2>Addresses (<code>print_r</code>)</h2>
    <output>{{ print_r(addresses) }}</output>
</div>
