<div{{ attributes }}>
    <div class="input-group">
        <button
            type="button"
            class="btn btn-primary"
            title="Decrement"
            {{ live_action('decrement') }}
        >-</button>
        <span class="input-group-text" data-testid="value">
            {{ value }}
        </span>
        <button
            type="button"
            class="btn btn-primary"
            title="Increment"
            {{ live_action('increment') }}
        >+</button>
    </div>
</div>
