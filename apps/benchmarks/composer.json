{
    "name": "symfony/ux-benchmarks-app",
    "description": "Benchmark app of the Symfony UX packages",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "beta",
    "require": {
        "php": ">=8.4",
        "symfony/console": "8.2.*",
        "symfony/form": "8.2.*",
        "symfony/framework-bundle": "8.2.*",
        "symfony/http-client": "8.2.*",
        "symfony/process": "8.2.*",
        "symfony/property-access": "8.2.*",
        "symfony/runtime": "8.2.*",
        "symfony/serializer": "8.2.*",
        "symfony/stimulus-bundle": "3.x-dev",
        "symfony/twig-bundle": "8.2.*",
        "symfony/ux-css": "3.x-dev",
        "symfony/ux-google-map": "3.x-dev",
        "symfony/ux-icons": "3.x-dev",
        "symfony/ux-leaflet-map": "3.x-dev",
        "symfony/ux-live-component": "3.x-dev",
        "symfony/ux-map": "3.x-dev",
        "symfony/ux-twig-component": "3.x-dev",
        "symfony/validator": "8.2.*",
        "tales-from-a-dev/twig-tailwind-extra": "^1.5",
        "twig/extra-bundle": "^3.24|^4.0",
        "twig/html-extra": "^3.24|^4.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    }
}
