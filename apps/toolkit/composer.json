{
    "name": "symfony/ux-toolkit-app",
    "description": "Renders every example of the UX Toolkit kits in isolation",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-intl": "*",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/ux-icons": "3.x-dev",
        "symfony/ux-toolkit": "3.x-dev",
        "symfony/ux-twig-component": "3.x-dev",
        "symfonycasts/tailwind-bundle": "^0.12",
        "tales-from-a-dev/twig-tailwind-extra": "^1.3.0",
        "twig/extra-bundle": "^3.24|^4.0",
        "twig/html-extra": "^3.24|^4.0",
        "twig/intl-extra": "^3.24|^4.0",
        "twig/twig": "^3.29|^4.0"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "classmap": [
            "../../src/Toolkit/tests/Fixtures/SecurityTwigStubExtension.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@preview:build"
        ],
        "post-update-cmd": [
            "@preview:build"
        ],
        "preview:build": [
            "@php bin/console cache:clear",
            "@php bin/console importmap:install",
            "for input in var/ux_toolkit/preview/ux-toolkit-*.css; do php bin/console tailwind:build \"$input\" || exit 1; done"
        ]
    }
}
