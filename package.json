{
    "private": true,
    "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0",
            "onFail": "warn"
        }
    },
    "type": "module",
    "config": {
        "baseline": "widely"
    },
    "workspaces": [
        "src/*/assets",
        "src/*/src/Bridge/*/assets"
    ],
    "scripts": {
        "build": "pnpm run --filter @symfony/ux-map build; sync; pnpm run --filter !@symfony/ux-map --recursive --aggregate-output build",
        "test": "pnpm run -r --workspace-concurrency=1 test",
        "test:unit": "pnpm run -r --workspace-concurrency=1 --aggregate-output test:unit",
        "test:unit:bin": "vitest --run --dir bin",
        "test:browser": "pnpm run -r --workspace-concurrency=1 test:browser",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:baseline": "node bin/check_baseline.ts",
        "update:tooling": "node bin/update_tooling_dependencies.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.0",
        "@puppeteer/browsers": "^3.2.4",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^6.10.0",
        "@tsdown/css": "^0.23.1",
        "@types/node": "^22.20.5",
        "browserslist": "^4.29.3",
        "lightningcss": "^1.33.0",
        "oxc-parser": "^0.153.0",
        "oxfmt": "^0.72.0",
        "oxlint": "^1.87.0",
        "pkg-types": "^2.3.3",
        "proxy-agent": "^8.0.2",
        "tinyglobby": "^0.2.17",
        "tsdown": "^0.23.1",
        "vitest": "^5.0.3",
        "web-features": "^3.42.0",
        "yaml": "^2.9.1"
    }
}
