{
    "private": true,
    "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "^22.18.0",
            "onFail": "warn"
        }
    },
    "type": "module",
    "config": {
        "baseline": "widely"
    },
    "workspaces": [
        "src/*/assets",
        "src/*/src/Bridge/*/assets"
    ],
    "scripts": {
        "build": "pnpm run --filter @symfony/ux-map build; sync; pnpm run --filter !@symfony/ux-map --recursive --aggregate-output build",
        "test": "pnpm run -r --workspace-concurrency=1 test",
        "test:unit": "pnpm run -r --workspace-concurrency=1 --aggregate-output test:unit",
        "test:unit:bin": "vitest --run --dir bin",
        "test:browser": "pnpm run -r --workspace-concurrency=1 test:browser",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "lint:baseline": "node bin/check_baseline.ts",
        "update:tooling": "node bin/update_tooling_dependencies.ts"
    },
    "devDependencies": {
        "@playwright/test": "^1.64.1",
        "@puppeteer/browsers": "^3.2.6",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/user-event": "^14.6.8",
        "@tsdown/css": "^0.23.2",
        "@types/google.maps": "^3.55.9",
        "@types/hotwired__turbo": "^8.0.4",
        "@types/leaflet": "^1.9.12",
        "@types/node": "^22.20.5",
        "@types/node-fetch": "^2.6.13",
        "@types/react": "^18.0 || ^19.0",
        "@types/react-dom": "^18.0 || ^19.0",
        "@types/webpack-env": "^1.18.8",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitejs/plugin-vue": "^6.0.10",
        "browserslist": "^4.29.4",
        "idiomorph": "^0.7.4",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.33.0",
        "node-fetch": "^3.3.2",
        "oxc-parser": "^0.155.0",
        "oxfmt": "^0.74.0",
        "oxlint": "^1.89.0",
        "pkg-types": "^2.4.0",
        "proxy-agent": "^8.0.2",
        "resize-observer-polyfill": "^1.5.1",
        "tinyglobby": "^0.2.17",
        "tsdown": "^0.23.2",
        "tslib": "^2.8.1",
        "typescript": "^6.0.3",
        "vitest": "^5.0.5",
        "vitest-canvas-mock": "^1.2.0",
        "vitest-fetch-mock": "^0.4.5",
        "web-features": "^3.44.0",
        "yaml": "^2.9.1"
    }
}
